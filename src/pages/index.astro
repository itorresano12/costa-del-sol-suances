---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import HostQuote from '../components/HostQuote.astro';
import ApartmentFeatures from '../components/ApartmentFeatures.astro';
import DirectBookingPerks from '../components/DirectBookingPerks.astro';
import BookingEngine from '../components/BookingEngine.astro';
import Experiences from '../components/Experiences.astro';
import LocationMap from '../components/LocationMap.astro';
import Footer from '../components/Footer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
---

<Layout 
  title="Apartamento Costa del Sol Suances | Alojamiento Boutique Frente al Mar Cantábrico"
  description="Alojamiento turístico de 70 m² con 3 dormitorios frente a la Playa de La Concha en Suances (Cantabria). Vistas al mar, WiFi y reserva directa garantizada sin comisiones de Airbnb ni Booking."
>
  <Navbar />
  <main>
    <Hero />
    <Gallery />
    <HostQuote />
    <ApartmentFeatures />
    <DirectBookingPerks />
    <BookingEngine />
    <Experiences />
    <LocationMap />
  </main>
  <Footer />
  <MobileStickyBar />
</Layout>
