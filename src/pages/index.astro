---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import ApartmentFeatures from '../components/ApartmentFeatures.astro';
import DirectBookingPerks from '../components/DirectBookingPerks.astro';
import BookingEngine from '../components/BookingEngine.astro';
import LocationMap from '../components/LocationMap.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Apartamento Costa del Sol Suances | Reserva Directa Sin Comisiones de Airbnb ni Booking"
  description="Alójate a 2 min a pie de la Playa de La Concha en Suances (Cantabria). Piso turístico de 70 m² con 3 dormitorios, salón con vistas al mar, cocina equipada con cafetera y nevera, baño con secador y WiFi gratis. Mejor precio garantizado."
>
  <Navbar />
  <main>
    <Hero />
    <Gallery />
    <ApartmentFeatures />
    <DirectBookingPerks />
    <BookingEngine />
    <LocationMap />
  </main>
  <Footer />
</Layout>
