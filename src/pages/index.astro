---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import HostQuote from '../components/HostQuote.astro';
import ApartmentFeatures from '../components/ApartmentFeatures.astro';
import DirectBookingPerks from '../components/DirectBookingPerks.astro';
import BookingEngine from '../components/BookingEngine.astro';
import Experiences from '../components/Experiences.astro';
import LocationMap from '../components/LocationMap.astro';
import Footer from '../components/Footer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
import { SITE_CONFIG } from '../config/site';
---

<Layout 
  title={SITE_CONFIG.defaultTitle}
  description={SITE_CONFIG.defaultDescription}
>
  <Navbar />
  <main>
    <Hero />
    <Gallery />
    <HostQuote />
    <ApartmentFeatures />
    <DirectBookingPerks />
    <BookingEngine />
    <Experiences />
    <LocationMap />
  </main>
  <Footer />
  <MobileStickyBar />
</Layout>
