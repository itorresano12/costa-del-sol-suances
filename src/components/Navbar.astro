---
import { Calendar, Phone, Globe } from 'lucide-astro';
import { translations } from '../i18n/translations';
import { SITE_CONFIG } from '../config/site';
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-[#FDFBF7]/90 border-b border-stone-200/60 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo Tipográfico Boutique -->
      <a href="#inicio" class="inline-flex flex-col group flex-shrink-0">
        <span class="font-serif tracking-widest text-base uppercase text-stone-900 font-normal leading-tight group-hover:text-stone-700 transition">
          COSTA DEL SOL
        </span>
        <span class="text-[9px] tracking-[0.28em] uppercase text-stone-500 font-semibold mt-0.5">
          SUANCES · CANTABRIA
        </span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-6 lg:gap-8 text-sm font-medium text-stone-600">
        <a href="#inicio" class="hover:text-stone-900 transition" data-i18n="navHome">Inicio</a>
        <a href="#galeria" class="hover:text-stone-900 transition" data-i18n="navGallery">Galería</a>
        <a href="#caracteristicas" class="hover:text-stone-900 transition" data-i18n="navRooms">3 Dormitorios</a>
        <a href="#experiencias" class="hover:text-stone-900 transition">Experiencias</a>
        <a href="#ventajas" class="hover:text-stone-900 transition" data-i18n="navPerks">Tarifa Directa</a>
        <a href="#ubicacion" class="hover:text-stone-900 transition" data-i18n="navLocation">Ubicación</a>
      </nav>

      <!-- Desktop Action Buttons & Language Selector -->
      <div class="hidden sm:flex items-center gap-3">
        
        <!-- Language Switcher (ES / EN) -->
        <div class="inline-flex items-center bg-stone-100 p-0.5 rounded-full border border-stone-200" role="group" aria-label="Selector de idioma">
          <button 
            type="button" 
            class="lang-toggle-btn bg-white text-stone-900 shadow-sm font-bold text-xs px-2.5 py-1 rounded-full cursor-pointer"
            data-target-lang="es"
            aria-label="Cambiar a Español"
          >
            ES
          </button>
          <button 
            type="button" 
            class="lang-toggle-btn text-stone-500 hover:text-stone-900 font-medium text-xs px-2 py-1 transition-colors rounded-full cursor-pointer"
            data-target-lang="en"
            aria-label="Switch to English"
          >
            EN
          </button>
        </div>

        <a 
          href={SITE_CONFIG.whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="p-2.5 rounded-full text-stone-600 hover:text-stone-900 hover:bg-stone-200/50 transition"
          title="Contacto directo por WhatsApp"
          aria-label="Contactar por WhatsApp"
        >
          <Phone class="w-4 h-4 stroke-[1.5]" />
        </a>

        <a 
          href="#reservas" 
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white font-medium text-xs sm:text-sm shadow-sm hover:shadow transition-all"
        >
          <Calendar class="w-3.5 h-3.5 text-stone-300 stroke-[1.5]" />
          <span data-i18n="navBookBtn">Reservar Directo</span>
        </a>
      </div>

      <!-- Mobile Right Controls (Language + CTA + Hamburger) -->
      <div class="flex md:hidden items-center gap-1.5 sm:gap-2">
        <!-- Mobile Language Selector -->
        <div class="inline-flex items-center bg-stone-100 p-0.5 rounded-full border border-stone-200 mr-1" role="group" aria-label="Selector de idioma móvil">
          <button 
            type="button" 
            class="lang-toggle-btn bg-white text-stone-900 shadow-sm font-bold text-xs px-2 py-0.5 rounded-full cursor-pointer"
            data-target-lang="es"
          >
            ES
          </button>
          <button 
            type="button" 
            class="lang-toggle-btn text-stone-500 hover:text-stone-900 font-medium text-xs px-2 py-0.5 transition-colors rounded-full cursor-pointer"
            data-target-lang="en"
          >
            EN
          </button>
        </div>

        <a 
          href="#reservas"
          class="px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-medium rounded-full shadow-sm"
          data-i18n="navBookShort"
        >
          Reservar
        </a>

        <button 
          id="mobile-menu-btn" 
          type="button" 
          class="p-2 text-stone-700 hover:bg-stone-200/50 rounded-xl focus:outline-none transition" 
          aria-label="Abrir menú de navegación"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-stone-200 bg-[#FDFBF7] px-4 pt-3 pb-6 space-y-3 shadow-lg">
    <a href="#inicio" class="block px-3 py-2 rounded-xl text-base font-normal text-stone-700 hover:bg-stone-100" data-i18n="navHome">Inicio</a>
    <a href="#galeria" class="block px-3 py-2 rounded-xl text-base font-normal text-stone-700 hover:bg-stone-100" data-i18n="navGallery">Galería de Fotos</a>
    <a href="#caracteristicas" class="block px-3 py-2 rounded-xl text-base font-normal text-stone-700 hover:bg-stone-100" data-i18n="navRooms">3 Dormitorios y 70 m²</a>
    <a href="#ventajas" class="block px-3 py-2 rounded-xl text-base font-normal text-stone-700 hover:bg-stone-100" data-i18n="navPerks">Ventajas Reserva Directa</a>
    <a href="#ubicacion" class="block px-3 py-2 rounded-xl text-base font-normal text-stone-700 hover:bg-stone-100" data-i18n="navLocation">Ubicación y Entorno</a>
    <a href="#reservas" class="block px-4 py-3 rounded-2xl text-center font-medium text-white bg-slate-900 shadow-md" data-i18n="navBookBtn">
      Reservar Ahora (Mejor Tarifa)
    </a>
  </div>
</header>

<script define:vars={{ translations }}>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }

  // Lógica de i18n cliente (Bilingüe ES / EN)
  function setLanguage(lang) {
    const dict = translations[lang] || translations.es;
    localStorage.setItem('preferred_lang', lang);
    document.documentElement.lang = lang;

    // Actualizar todos los elementos con data-i18n
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (key && dict[key]) {
        el.textContent = dict[key];
      }
    });

    // Actualizar botones de idioma en desktop y móvil con contraste real
    document.querySelectorAll('.lang-toggle-btn').forEach((button) => {
      const targetLang = button.getAttribute('data-target-lang');
      const isMobile = button.closest('.md\\:hidden') !== null;
      const paddingClass = isMobile ? 'px-2 py-0.5' : 'px-2.5 py-1';
      if (targetLang === lang) {
        button.className = `lang-toggle-btn bg-white text-stone-900 shadow-sm font-bold text-xs ${paddingClass} rounded-full cursor-pointer`;
      } else {
        button.className = `lang-toggle-btn text-stone-500 hover:text-stone-900 font-medium text-xs ${paddingClass} transition-colors rounded-full cursor-pointer`;
      }
    });
  }

  // Inicializar según preferencia guardada o idioma del navegador
  const savedLang = localStorage.getItem('preferred_lang') || 
    (navigator.language && navigator.language.startsWith('en') ? 'en' : 'es');

  if (savedLang === 'en') {
    setLanguage('en');
  }

  // Asignar listeners a todos los botones de idioma
  document.querySelectorAll('.lang-toggle-btn').forEach((button) => {
    button.addEventListener('click', (e) => {
      const targetLang = (e.currentTarget).getAttribute('data-target-lang');
      if (targetLang) setLanguage(targetLang);
    });
  });
</script>
