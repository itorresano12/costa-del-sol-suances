---
import { Camera, Maximize2, X, ChevronLeft, ChevronRight, LayoutGrid } from 'lucide-astro';

const allPhotos = [
  {
    id: 1,
    title: "Vistas al Mar Cantábrico y Playa de La Concha",
    url: "/images/apartamento/hero-vistas.jpg",
    desc: "Vistas despejadas a la bahía de Suances a tan solo 2 minutos a pie de la orilla."
  },
  {
    id: 2,
    title: "Salón Principal y Zona de Estar",
    url: "/images/apartamento/salon-1.jpg",
    desc: "Espacio luminoso con luz natural, amplio sofá y televisión Smart TV."
  },
  {
    id: 3,
    title: "Dormitorio Principal (Cama 150 cm)",
    url: "/images/apartamento/dormitorio-principal.jpg",
    desc: "Cama doble confortable de 150 cm con ropa de cama de algodón y amplio armario."
  },
  {
    id: 4,
    title: "Cocina Equipada",
    url: "/images/apartamento/cocina.jpg",
    desc: "Nevera grande con congelador, cafetera para desayunos, microondas y menaje completo."
  },
  {
    id: 5,
    title: "Terraza y Vistas Panorámicas",
    url: "/images/apartamento/terraza-vistas.jpg",
    desc: "Brisa marina y vistas abiertas sobre la costa cántabra."
  },
  {
    id: 6,
    title: "Zona de Estar Luminosa",
    url: "/images/apartamento/salon-2.jpg",
    desc: "Zona de relax perfecta para descansar en familia."
  },
  {
    id: 7,
    title: "Segundo Dormitorio (2 Camas)",
    url: "/images/apartamento/dormitorio-2.jpg",
    desc: "Dos camas individuales de 90 cm confortables y almacenamiento."
  },
  {
    id: 8,
    title: "Tercer Dormitorio Independiente",
    url: "/images/apartamento/dormitorio-3.jpg",
    desc: "Habitación acogedora con cama individual / nido independiente."
  },
  {
    id: 9,
    title: "Baño Completo con Ducha",
    url: "/images/apartamento/bano.jpg",
    desc: "Plato de ducha amplio con mampara, secador de pelo potente y toallas."
  },
  {
    id: 10,
    title: "Mesa de Comedor Familiar",
    url: "/images/apartamento/comedor.jpg",
    desc: "Mesa espaciosa para compartir veladas gastronómicas."
  },
  {
    id: 11,
    title: "Edificio y Entorno Residencial",
    url: "/images/apartamento/edificio-exterior.jpg",
    desc: "Ubicación tranquila y accesible con zonas de aparcamiento."
  },
  {
    id: 12,
    title: "Paseo de la Playa de La Concha",
    url: "/images/apartamento/entorno-playa.jpg",
    desc: "A solo 150 metros del portal: arena dorada, gastronomía y paseos marineros."
  }
];

// 5 Fotos seleccionadas para la cuadrícula Bento principal
const bentoPhotos = allPhotos.slice(0, 5);
---

<section id="galeria" class="py-20 lg:py-28 bg-[#FDFBF7]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header Editorial -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="text-stone-500 text-xs sm:text-sm tracking-widest uppercase font-medium">
        Galería Fotográfica
      </span>
      <h2 class="font-serif text-3xl sm:text-5xl font-normal text-stone-900 tracking-tight mt-3 mb-4">
        Espacios serenos con alma cántabra
      </h2>
      <p class="text-stone-600 text-base sm:text-lg font-light leading-relaxed">
        Cada rincón pensado para descansar, sentir la brisa del norte y compartir momentos inolvidables.
      </p>
    </div>

    <!-- Asymmetrical Bento Grid (5 Pristine Clean Photos) -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 sm:gap-5">
      
      <!-- Main Featured Photo (Left Column, Spans 2 cols & 2 rows) -->
      <div 
        class="bento-card md:col-span-2 md:row-span-2 relative rounded-3xl overflow-hidden cursor-pointer group bg-stone-100 border border-stone-200/80 shadow-sm"
        data-photo-index="0"
      >
        <div class="w-full h-[360px] md:h-[500px] overflow-hidden">
          <img 
            src={bentoPhotos[0].url} 
            alt={bentoPhotos[0].title}
            class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700 ease-out"
            loading="eager"
          />
        </div>
        <!-- Minimal subtle hover overlay (no clunky black text bars) -->
        <div class="absolute inset-0 bg-stone-900/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
          <div class="w-12 h-12 rounded-full bg-white/90 backdrop-blur-md text-stone-900 flex items-center justify-center shadow-lg transform scale-90 group-hover:scale-100 transition-transform">
            <Maximize2 class="w-5 h-5 stroke-[1.5]" />
          </div>
        </div>
      </div>

      <!-- 4 Complementary Photos (2x2 Grid on Desktop) -->
      {bentoPhotos.slice(1, 5).map((photo, idx) => (
        <div 
          class="bento-card md:col-span-1 relative rounded-2xl overflow-hidden cursor-pointer group bg-stone-100 border border-stone-200/80 shadow-sm"
          data-photo-index={idx + 1}
        >
          <div class="w-full h-[240px] overflow-hidden">
            <img 
              src={photo.url} 
              alt={photo.title}
              class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700 ease-out"
              loading="lazy"
            />
          </div>
          <!-- Minimal subtle hover overlay -->
          <div class="absolute inset-0 bg-stone-900/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
            <div class="w-10 h-10 rounded-full bg-white/90 backdrop-blur-md text-stone-900 flex items-center justify-center shadow-lg transform scale-90 group-hover:scale-100 transition-transform">
              <Maximize2 class="w-4 h-4 stroke-[1.5]" />
            </div>
          </div>
        </div>
      ))}

    </div>

    <!-- Clean Bottom Action Button -->
    <div class="mt-10 text-center">
      <button 
        id="open-full-gallery-btn"
        type="button"
        class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-full bg-white border border-stone-300 hover:border-stone-400 text-stone-800 text-sm font-medium shadow-sm hover:shadow transition-all group"
      >
        <LayoutGrid class="w-4 h-4 text-stone-600 group-hover:text-stone-900 transition-colors" />
        <span>Ver colección fotográfica completa ({allPhotos.length} fotos)</span>
      </button>
    </div>

  </div>
</section>

<!-- Fullscreen Gallery Lightbox Modal -->
<div id="boutique-modal" class="fixed inset-0 z-50 bg-stone-950/95 backdrop-blur-md hidden flex items-center justify-center p-4 sm:p-6 transition-all duration-300" role="dialog" aria-modal="true">
  
  <div class="relative max-w-5xl w-full flex flex-col items-center">
    
    <!-- Top Modal Controls -->
    <div class="w-full flex items-center justify-between text-white pb-4 border-b border-stone-800">
      <div class="flex items-center gap-3">
        <span class="text-xs uppercase tracking-widest text-stone-400 font-medium">Colección</span>
        <span id="modal-counter" class="text-xs text-stone-300 font-mono">1 / {allPhotos.length}</span>
      </div>
      <button 
        id="close-boutique-modal" 
        class="p-2 rounded-full text-stone-400 hover:text-white hover:bg-white/10 transition"
        aria-label="Cerrar visor"
      >
        <X class="w-6 h-6 stroke-[1.5]" />
      </button>
    </div>

    <!-- Active Main Image with Navigation -->
    <div class="relative w-full h-[55vh] sm:h-[65vh] flex items-center justify-center my-4 overflow-hidden rounded-2xl bg-stone-900">
      <img 
        id="modal-active-img" 
        src="" 
        alt="" 
        class="max-h-full max-w-full object-contain transition-opacity duration-300"
      />

      <!-- Prev / Next Navigation Arrows -->
      <button 
        id="prev-photo-btn"
        class="absolute left-3 p-3 rounded-full bg-stone-900/80 hover:bg-stone-900 text-white border border-white/10 backdrop-blur-sm transition-all"
        aria-label="Foto anterior"
      >
        <ChevronLeft class="w-5 h-5 stroke-[1.5]" />
      </button>

      <button 
        id="next-photo-btn"
        class="absolute right-3 p-3 rounded-full bg-stone-900/80 hover:bg-stone-900 text-white border border-white/10 backdrop-blur-sm transition-all"
        aria-label="Foto siguiente"
      >
        <ChevronRight class="w-5 h-5 stroke-[1.5]" />
      </button>
    </div>

    <!-- Caption / Description -->
    <div class="text-center max-w-xl px-4">
      <h3 id="modal-title" class="font-serif text-lg sm:text-xl text-white font-normal"></h3>
      <p id="modal-desc" class="text-xs sm:text-sm text-stone-400 font-light mt-1"></p>
    </div>

    <!-- Thumbnails Strip -->
    <div class="flex items-center gap-2 mt-4 overflow-x-auto max-w-full py-2 px-1 scrollbar-none">
      {allPhotos.map((photo, i) => (
        <button 
          class="thumb-btn flex-shrink-0 w-14 h-10 rounded-lg overflow-hidden border border-transparent opacity-60 hover:opacity-100 transition-all focus:outline-none"
          data-index={i}
        >
          <img src={photo.url} alt="" class="w-full h-full object-cover" />
        </button>
      ))}
    </div>

  </div>
</div>

<script define:vars={{ allPhotos }}>
  let currentIndex = 0;
  const modal = document.getElementById('boutique-modal');
  const modalImg = document.getElementById('modal-active-img');
  const modalTitle = document.getElementById('modal-title');
  const modalDesc = document.getElementById('modal-desc');
  const modalCounter = document.getElementById('modal-counter');
  const closeBtn = document.getElementById('close-boutique-modal');
  const prevBtn = document.getElementById('prev-photo-btn');
  const nextBtn = document.getElementById('next-photo-btn');
  const openFullBtn = document.getElementById('open-full-gallery-btn');
  const bentoCards = document.querySelectorAll('.bento-card');
  const thumbBtns = document.querySelectorAll('.thumb-btn');

  function updateModal(index) {
    if (index < 0) index = allPhotos.length - 1;
    if (index >= allPhotos.length) index = 0;
    currentIndex = index;

    const photo = allPhotos[currentIndex];
    if (modalImg) modalImg.src = photo.url;
    if (modalTitle) modalTitle.textContent = photo.title;
    if (modalDesc) modalDesc.textContent = photo.desc;
    if (modalCounter) modalCounter.textContent = `${currentIndex + 1} / ${allPhotos.length}`;

    // Highlight active thumbnail
    thumbBtns.forEach((btn, idx) => {
      if (idx === currentIndex) {
        btn.classList.add('border-white', 'opacity-100', 'scale-105');
        btn.classList.remove('opacity-60');
      } else {
        btn.classList.remove('border-white', 'scale-105');
        btn.classList.add('opacity-60');
      }
    });
  }

  function openModal(index = 0) {
    updateModal(index);
    if (modal) {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  bentoCards.forEach(card => {
    card.addEventListener('click', () => {
      const idx = parseInt(card.getAttribute('data-photo-index') || '0', 10);
      openModal(idx);
    });
  });

  if (openFullBtn) {
    openFullBtn.addEventListener('click', () => openModal(0));
  }

  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (prevBtn) prevBtn.addEventListener('click', () => updateModal(currentIndex - 1));
  if (nextBtn) nextBtn.addEventListener('click', () => updateModal(currentIndex + 1));

  thumbBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
      updateModal(idx);
    });
  });

  // Close with Escape or background click
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowLeft') updateModal(currentIndex - 1);
    if (e.key === 'ArrowRight') updateModal(currentIndex + 1);
  });

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }
</script>
