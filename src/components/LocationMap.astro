---
import { MapPin, Navigation, Compass, Waves, Utensils, Car } from 'lucide-astro';
---

<section id="ubicacion" class="py-20 bg-slate-50 border-t border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-50 border border-teal-200 text-teal-800 text-xs font-bold uppercase tracking-wider mb-3">
        <MapPin class="w-3.5 h-3.5 text-teal-600" />
        <span>Ubicación Inmejorable</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        A 2 minutos a pie de la Playa de La Concha
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        Olvídate de coger el coche para ir a la playa. El Apartamento Costa del Sol está ubicado en la zona costera de Suances, frente al mar y con todos los servicios a mano.
      </p>
    </div>

    <!-- Content: POI List + Map Frame -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Left: Distances & Highlights -->
      <div class="lg:col-span-5 space-y-4">
        
        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center flex-shrink-0">
            <Waves class="w-5 h-5" />
          </div>
          <div>
            <h4 class="font-extrabold text-slate-900 text-base">Playa de La Concha</h4>
            <p class="text-xs text-slate-600 mt-0.5">La playa principal de arena fina de Suances. Ideal para familias y baños tranquilos.</p>
            <span class="inline-block mt-2 text-xs font-bold text-teal-700 bg-teal-50 px-2.5 py-0.5 rounded-full">
              🚶 A 2 minutos a pie (150 m)
            </span>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center flex-shrink-0">
            <Compass class="w-5 h-5" />
          </div>
          <div>
            <h4 class="font-extrabold text-slate-900 text-base">Playa de Los Locos (Surf)</h4>
            <p class="text-xs text-slate-600 mt-0.5">Reserva natural del surf en el norte de España y puestas de sol mágicas sobre los acantilados.</p>
            <span class="inline-block mt-2 text-xs font-bold text-blue-700 bg-blue-50 px-2.5 py-0.5 rounded-full">
              🏄 A 10 min a pie / 3 min en coche
            </span>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center flex-shrink-0">
            <Utensils class="w-5 h-5" />
          </div>
          <div>
            <h4 class="font-extrabold text-slate-900 text-base">Paseo Marítimo y Restaurantes</h4>
            <p class="text-xs text-slate-600 mt-0.5">Marisquerías, terrazas, heladerías, panaderías artesanas y supermercados a tu disposición.</p>
            <span class="inline-block mt-2 text-xs font-bold text-amber-800 bg-amber-50 px-2.5 py-0.5 rounded-full">
              🚶 A 3-5 minutos a pie
            </span>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center flex-shrink-0">
            <Car class="w-5 h-5" />
          </div>
          <div>
            <h4 class="font-extrabold text-slate-900 text-base">Cantabria Infinita a tu Alcance</h4>
            <p class="text-xs text-slate-600 mt-0.5">Santillana del Mar a 10 min, Santander a 25 min, Parque de Cabárceno y Cueva de El Soplao a menos de 40 min.</p>
            <span class="inline-block mt-2 text-xs font-bold text-emerald-800 bg-emerald-50 px-2.5 py-0.5 rounded-full">
              🚗 Conexión rápida por autovía A-67
            </span>
          </div>
        </div>

      </div>

      <!-- Right: Responsive Interactive Map Frame -->
      <div class="lg:col-span-7">
        <div class="rounded-3xl overflow-hidden shadow-xl border-4 border-white bg-slate-200 relative h-[440px]">
          <!-- Map Iframe with Suances Playa de la Concha coordinates -->
          <iframe 
            title="Ubicación Apartamento Costa del Sol Suances"
            class="w-full h-full border-0 filter contrast-105"
            src="https://www.openstreetmap.org/export/embed.html?bbox=-4.055%2C43.425%2C-4.030%2C43.442&layer=mapnik&marker=43.434%2C-4.041"
            loading="lazy"
          ></iframe>

          <!-- Floating Map Marker Pill -->
          <div class="absolute top-4 left-4 bg-white/95 backdrop-blur-md px-4 py-2.5 rounded-2xl shadow-lg border border-slate-200 flex items-center gap-2 text-xs font-bold text-slate-800">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
            <span>Apartamento Costa del Sol • Suances</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

