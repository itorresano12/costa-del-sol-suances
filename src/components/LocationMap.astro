---
import { Compass, Waves, UtensilsCrossed, Car } from 'lucide-astro';
---

<section id="ubicacion" class="scroll-mt-28 pt-8 pb-20 lg:pb-28 bg-[#FDFBF7] border-t border-stone-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header Editorial -->
    <div class="text-center max-w-3xl mx-auto mb-14 lg:mb-16">
      <span class="text-stone-500 text-xs sm:text-sm tracking-widest uppercase font-medium" data-i18n="locPill">
        Ubicación & Entorno
      </span>
      <h2 class="font-serif text-3xl sm:text-5xl font-normal text-stone-900 tracking-tight mt-3 mb-4" data-i18n="locTitle">
        A dos minutos a pie de la orilla
      </h2>
      <p class="text-stone-600 text-base sm:text-lg font-light leading-relaxed" data-i18n="locDesc">
        Olvídate del coche durante tu estancia. El Apartamento Costa del Sol se sitúa en la mejor zona costera de Suances, frente a la Playa de La Concha.
      </p>
    </div>

    <!-- Content: POI List + Map Frame (Aligned Geometric Balance) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch max-w-6xl mx-auto">
      
      <!-- Left: Distances & Highlights -->
      <div class="lg:col-span-5 space-y-4 flex flex-col justify-between">
        
        <div class="p-6 rounded-3xl bg-white border border-stone-200/80 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.03)] flex items-start gap-4">
          <div class="w-10 h-10 rounded-2xl bg-stone-50 border border-stone-200/60 text-stone-900 flex items-center justify-center flex-shrink-0">
            <Waves class="w-5 h-5 stroke-[1.25]" />
          </div>
          <div>
            <h3 class="font-serif text-lg text-stone-900 font-normal tracking-tight">Playa de La Concha</h3>
            <p class="text-xs text-stone-600 font-normal mt-0.5">La playa principal de arena dorada de Suances, perfecta para familias y paseos marineros.</p>
            <span class="inline-block mt-2.5 text-xs font-medium text-stone-700 bg-stone-100 px-3 py-1 rounded-full">
              🚶 A 2 minutos a pie (150 m)
            </span>
          </div>
        </div>

        <div class="p-6 rounded-3xl bg-white border border-stone-200/80 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.03)] flex items-start gap-4">
          <div class="w-10 h-10 rounded-2xl bg-stone-50 border border-stone-200/60 text-stone-900 flex items-center justify-center flex-shrink-0">
            <Compass class="w-5 h-5 stroke-[1.25]" />
          </div>
          <div>
            <h3 class="font-serif text-lg text-stone-900 font-normal tracking-tight">Playa de Los Locos</h3>
            <p class="text-xs text-stone-600 font-normal mt-0.5">Reserva natural del surf en el norte de España y puestas de sol sobre los acantilados.</p>
            <span class="inline-block mt-2.5 text-xs font-medium text-stone-700 bg-stone-100 px-3 py-1 rounded-full">
              🏄 A 10 min a pie / 3 min en coche
            </span>
          </div>
        </div>

        <div class="p-6 rounded-3xl bg-white border border-stone-200/80 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.03)] flex items-start gap-4">
          <div class="w-10 h-10 rounded-2xl bg-stone-50 border border-stone-200/60 text-stone-900 flex items-center justify-center flex-shrink-0">
            <UtensilsCrossed class="w-5 h-5 stroke-[1.25]" />
          </div>
          <div>
            <h3 class="font-serif text-lg text-stone-900 font-normal tracking-tight">Paseo Marítimo & Marisquerías</h3>
            <p class="text-xs text-stone-600 font-normal mt-0.5">Gastronomía marina, terrazas con vistas, panaderías artesanas y supermercados próximos.</p>
            <span class="inline-block mt-2.5 text-xs font-medium text-stone-700 bg-stone-100 px-3 py-1 rounded-full">
              🚶 A 3-5 minutos a pie
            </span>
          </div>
        </div>

        <div class="p-6 rounded-3xl bg-white border border-stone-200/80 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.03)] flex items-start gap-4">
          <div class="w-10 h-10 rounded-2xl bg-stone-50 border border-stone-200/60 text-stone-900 flex items-center justify-center flex-shrink-0">
            <Car class="w-5 h-5 stroke-[1.25]" />
          </div>
          <div>
            <h3 class="font-serif text-lg text-stone-900 font-normal tracking-tight">Cantabria Infinita</h3>
            <p class="text-xs text-stone-600 font-normal mt-0.5">Santillana del Mar a 10 min, Santander a 25 min, Parque de Cabárceno y Comillas a menos de 40 min.</p>
            <span class="inline-block mt-2.5 text-xs font-medium text-stone-700 bg-stone-100 px-3 py-1 rounded-full">
              🚗 Conexión rápida autovía A-67
            </span>
          </div>
        </div>

      </div>

      <!-- Right: Responsive Interactive Map Frame with Warm Editorial Filter & Matched Height -->
      <div class="lg:col-span-7 w-full pt-2 lg:pt-0 flex flex-col">
        <div class="rounded-3xl overflow-hidden shadow-xl border border-stone-200/80 bg-stone-100 relative h-full min-h-[400px] lg:min-h-full w-full flex-1">
          <iframe 
            title="Ubicación Apartamento Costa del Sol Suances"
            class="w-full h-full min-h-[400px] lg:min-h-full object-cover border-0 filter contrast-[0.95] sepia-[0.10] hue-rotate-[-15deg] brightness-[0.98]"
            src="https://www.openstreetmap.org/export/embed.html?bbox=-4.055%2C43.425%2C-4.030%2C43.442&layer=mapnik&marker=43.434%2C-4.041"
            loading="lazy"
          ></iframe>

          <!-- Floating Map Marker Pill -->
          <div class="absolute top-4 left-4 bg-white/95 backdrop-blur-md px-4 py-2.5 rounded-full shadow-lg border border-stone-200 flex items-center gap-2.5 text-xs font-medium text-stone-800">
            <span class="w-2 h-2 rounded-full bg-slate-900 animate-ping"></span>
            <span>Apartamento Costa del Sol • Suances</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
