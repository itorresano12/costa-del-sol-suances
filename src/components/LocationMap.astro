---
import { Compass, Waves, UtensilsCrossed, Car, ExternalLink } from 'lucide-astro';
---

<section id="ubicacion" class="scroll-mt-28 w-full bg-[#F4EFE6] py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header Editorial -->
    <div class="text-center max-w-3xl mx-auto mb-14 lg:mb-16">
      <span class="text-dorado-arena text-xs sm:text-sm tracking-widest uppercase font-semibold" data-i18n="locPill">
        Ubicación & Entorno
      </span>
      <h2 class="font-serif text-3xl sm:text-5xl font-normal text-marino-vibrante tracking-tight mt-3 mb-4" data-i18n="locTitle">
        A dos minutos a pie de la orilla
      </h2>
      <p class="text-stone-600 text-base sm:text-lg font-light leading-relaxed" data-i18n="locDesc">
        Olvídate del coche durante tu estancia. El Apartamento Costa del Sol se sitúa en la mejor zona costera de Suances, frente a la Playa de La Concha.
      </p>
    </div>

    <!-- Content: POI List (Left) + Interactive Map Frame (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch max-w-6xl mx-auto">
      
      <!-- Left: Distances & Highlights in White Cards -->
      <div class="lg:col-span-5 space-y-4 flex flex-col justify-between">
        
        <div class="p-6 rounded-2xl bg-white border border-stone-200/80 shadow-sm flex items-start gap-4">
          <div class="w-10 h-10 rounded-2xl bg-salvia/15 border border-salvia/20 text-salvia-accent flex items-center justify-center flex-shrink-0">
            <Waves class="w-5 h-5 stroke-[1.5]" />
          </div>
          <div>
            <h3 class="font-serif text-lg text-marino-vibrante font-normal tracking-tight">Playa de La Concha</h3>
            <p class="text-xs text-stone-600 font-normal mt-0.5">La playa principal de arena dorada de Suances, perfecta para familias y paseos marineros.</p>
            <span class="inline-block mt-2.5 text-xs font-semibold text-salvia-accent bg-[#D5E0D5]/50 border border-[#5F7D6B]/30 px-3 py-1 rounded-full">
              🚶 A 2 minutos a pie (150 m)
            </span>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-stone-200/80 shadow-sm flex items-start gap-4">
          <div class="w-10 h-10 rounded-2xl bg-salvia/15 border border-salvia/20 text-salvia-accent flex items-center justify-center flex-shrink-0">
            <Compass class="w-5 h-5 stroke-[1.5]" />
          </div>
          <div>
            <h3 class="font-serif text-lg text-marino-vibrante font-normal tracking-tight">Playa de Los Locos</h3>
            <p class="text-xs text-stone-600 font-normal mt-0.5">Reserva natural del surf en el norte de España y puestas de sol sobre los acantilados.</p>
            <span class="inline-block mt-2.5 text-xs font-semibold text-salvia-accent bg-[#D5E0D5]/50 border border-[#5F7D6B]/30 px-3 py-1 rounded-full">
              🏄 A 10 min a pie / 3 min en coche
            </span>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-stone-200/80 shadow-sm flex items-start gap-4">
          <div class="w-10 h-10 rounded-2xl bg-salvia/15 border border-salvia/20 text-salvia-accent flex items-center justify-center flex-shrink-0">
            <UtensilsCrossed class="w-5 h-5 stroke-[1.5]" />
          </div>
          <div>
            <h3 class="font-serif text-lg text-marino-vibrante font-normal tracking-tight">Paseo Marítimo & Marisquerías</h3>
            <p class="text-xs text-stone-600 font-normal mt-0.5">Gastronomía marina, terrazas con vistas, panaderías artesanas y supermercados próximos.</p>
            <span class="inline-block mt-2.5 text-xs font-semibold text-salvia-accent bg-[#D5E0D5]/50 border border-[#5F7D6B]/30 px-3 py-1 rounded-full">
              🚶 A 3-5 minutos a pie
            </span>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-stone-200/80 shadow-sm flex items-start gap-4">
          <div class="w-10 h-10 rounded-2xl bg-salvia/15 border border-salvia/20 text-salvia-accent flex items-center justify-center flex-shrink-0">
            <Car class="w-5 h-5 stroke-[1.5]" />
          </div>
          <div>
            <h3 class="font-serif text-lg text-marino-vibrante font-normal tracking-tight">Cantabria Infinita</h3>
            <p class="text-xs text-stone-600 font-normal mt-0.5">Santillana del Mar a 10 min, Santander a 25 min, Parque de Cabárceno y Comillas a menos de 40 min.</p>
            <span class="inline-block mt-2.5 text-xs font-semibold text-salvia-accent bg-[#D5E0D5]/50 border border-[#5F7D6B]/30 px-3 py-1 rounded-full">
              🚗 Conexión rápida autovía A-67
            </span>
          </div>
        </div>

      </div>

      <!-- Right: Responsive Interactive Map Frame with Guaranteed Rendering -->
      <div class="lg:col-span-7 w-full pt-2 lg:pt-0 flex flex-col">
        <div class="rounded-2xl overflow-hidden shadow-md border border-stone-200/80 bg-stone-100 relative h-full min-h-[420px] lg:min-h-full w-full flex-1">
          <iframe 
            title="Mapa de Ubicación Apartamento Costa del Sol Suances"
            class="w-full h-full min-h-[420px] lg:min-h-full border-0"
            src="https://maps.google.com/maps?q=Playa+de+La+Concha,+Suances,+Cantabria&t=&z=15&ie=UTF8&iwloc=&output=embed"
            loading="lazy"
            allowfullscreen
          ></iframe>

          <!-- Floating Map Marker Pill with Open Link -->
          <div class="absolute top-4 left-4 right-4 sm:right-auto bg-white/95 backdrop-blur-md px-4 py-2.5 rounded-full shadow-lg border border-stone-200 flex items-center justify-between sm:justify-start gap-3 text-xs font-medium text-marino-vibrante">
            <div class="flex items-center gap-2">
              <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-dorado-arena opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-dorado-arena"></span>
              </span>
              <span>Costa del Sol · Playa de La Concha</span>
            </div>
            <a 
              href="https://maps.google.com/?q=Playa+de+La+Concha,+Suances,+Cantabria" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-salvia-accent hover:text-marino-vibrante flex items-center gap-1 font-semibold pl-2 border-l border-stone-200 transition"
              title="Abrir en Google Maps"
            >
              <span>Abrir</span>
              <ExternalLink class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
