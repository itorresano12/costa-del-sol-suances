---
import { Calendar, Sparkles, MessageCircle } from 'lucide-astro';
---

<!-- Mobile Sticky Booking Bar (Boutique Coastal Luxury) -->
<div 
  id="mobile-sticky-bar" 
  class="fixed bottom-0 inset-x-0 z-40 md:hidden bg-[#FDFBF7]/95 backdrop-blur-md border-t border-stone-200/80 shadow-[0_-8px_30px_rgba(0,0,0,0.06)] px-4 py-3 transition-transform duration-300"
>
  <div class="max-w-md mx-auto flex items-center justify-between gap-3">
    
    <!-- Price & Direct Discount Info -->
    <div class="flex flex-col">
      <div class="flex items-center gap-1.5">
        <span class="text-xs text-stone-500 font-light">Desde</span>
        <span class="font-serif text-xl font-normal text-stone-900 tracking-tight">110 €</span>
        <span class="text-xs text-stone-500 font-light">/ noche</span>
      </div>
      <div class="flex items-center gap-1 mt-0.5">
        <span class="inline-flex items-center gap-1 text-[10px] text-stone-600 font-light">
          <Sparkles class="w-3 h-3 text-stone-500 stroke-[1.5]" />
          Tarifa directa sin comisiones
        </span>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex items-center gap-2">
      <!-- WhatsApp Quick Contact -->
      <a 
        href="https://wa.me/34600123456?text=Hola%20Ivan,%20quería%20consultar%20fechas%20para%20Apartamento%20Costa%20del%20Sol%20Suances" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-11 h-11 rounded-2xl bg-stone-100 text-stone-700 border border-stone-200 flex items-center justify-center hover:bg-stone-200 active:scale-95 transition"
        aria-label="Contactar por WhatsApp"
      >
        <MessageCircle class="w-5 h-5 stroke-[1.5]" />
      </a>

      <!-- Main Direct Booking CTA -->
      <a 
        href="#reservas" 
        class="px-5 py-3 rounded-2xl bg-slate-900 hover:bg-slate-800 text-white font-medium text-xs sm:text-sm shadow-md active:scale-95 transition flex items-center gap-2 whitespace-nowrap"
      >
        <Calendar class="w-4 h-4 text-stone-300 stroke-[1.5]" />
        <span>Reservar</span>
      </a>
    </div>

  </div>
</div>
