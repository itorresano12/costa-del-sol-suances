---
import { Calendar, Sparkles, MessageCircle } from 'lucide-astro';
---

<!-- Mobile Sticky Booking Bar (Fixed thumb-zone conversion trigger) -->
<div 
  id="mobile-sticky-bar" 
  class="fixed bottom-0 inset-x-0 z-40 md:hidden bg-white/95 backdrop-blur-md border-t border-slate-200/90 shadow-[0_-8px_30px_rgb(0,0,0,0.12)] px-4 py-3 transition-transform duration-300"
>
  <div class="max-w-md mx-auto flex items-center justify-between gap-3">
    
    <!-- Price & Direct Discount Info -->
    <div class="flex flex-col">
      <div class="flex items-center gap-1.5">
        <span class="text-xs text-slate-500 font-medium">Desde</span>
        <span class="text-xl font-extrabold text-slate-900 tracking-tight">110 €</span>
        <span class="text-xs text-slate-500 font-medium">/ noche</span>
      </div>
      <div class="flex items-center gap-1 mt-0.5">
        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md bg-emerald-100 text-emerald-800 text-[10px] font-bold">
          <Sparkles class="w-3 h-3 text-emerald-600" />
          -15% sin comisiones
        </span>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex items-center gap-2">
      <!-- WhatsApp Quick Contact -->
      <a 
        href="https://wa.me/34600123456?text=Hola%20Ivan,%20quería%20consultar%20fechas%20para%20Apartamento%20Costa%20del%20Sol%20Suances" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-11 h-11 rounded-2xl bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center justify-center hover:bg-emerald-100 active:scale-95 transition"
        aria-label="Contactar por WhatsApp"
      >
        <MessageCircle class="w-5 h-5 text-emerald-600" />
      </a>

      <!-- Main Direct Booking CTA -->
      <a 
        href="#reservas" 
        class="px-5 py-3 rounded-2xl bg-gradient-to-r from-teal-600 to-emerald-600 hover:from-teal-700 hover:to-emerald-700 text-white font-extrabold text-sm shadow-lg shadow-teal-700/25 active:scale-95 transition flex items-center gap-2 whitespace-nowrap"
      >
        <Calendar class="w-4 h-4 text-teal-100" />
        <span>Reservar</span>
      </a>
    </div>

  </div>
</div>

