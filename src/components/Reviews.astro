---
import { Star } from 'lucide-astro';
---

<section class="w-full bg-white py-24">
  <div class="text-center max-w-7xl mx-auto px-4">
    <h2 class="text-3xl font-serif text-[#0A2342] reveal">
      Lo que dicen nuestros huéspedes
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-7xl mx-auto px-4 mt-12">
    <!-- Tarjeta 1 -->
    <div class="bg-[#F4EFE6] rounded-2xl p-8 reveal">
      <div class="text-[#C4A47C] flex gap-1 mb-6">
        <Star class="w-5 h-5 fill-current" />
        <Star class="w-5 h-5 fill-current" />
        <Star class="w-5 h-5 fill-current" />
        <Star class="w-5 h-5 fill-current" />
        <Star class="w-5 h-5 fill-current" />
      </div>
      <p class="italic text-gray-700 mb-6">"Aquí irá la reseña real de Airbnb/Booking destacando la limpieza, las vistas o la atención de Iván."</p>
      <p class="font-semibold text-[#0A2342]">Nombre del Huésped</p>
      <p class="text-sm text-gray-500">Huésped en Airbnb - 5/5</p>
    </div>

    <!-- Tarjeta 2 -->
    <div class="bg-[#F4EFE6] rounded-2xl p-8 reveal">
      <div class="text-[#C4A47C] flex gap-1 mb-6">
        <Star class="w-5 h-5 fill-current" />
        <Star class="w-5 h-5 fill-current" />
        <Star class="w-5 h-5 fill-current" />
        <Star class="w-5 h-5 fill-current" />
        <Star class="w-5 h-5 fill-current" />
      </div>
      <p class="italic text-gray-700 mb-6">"Aquí irá la reseña real de Airbnb/Booking destacando la limpieza, las vistas o la atención de Iván."</p>
      <p class="font-semibold text-[#0A2342]">Nombre del Huésped</p>
      <p class="text-sm text-gray-500">Huésped en Airbnb - 5/5</p>
    </div>

    <!-- Tarjeta 3 -->
    <div class="bg-[#F4EFE6] rounded-2xl p-8 reveal">
      <div class="text-[#C4A47C] flex gap-1 mb-6">
        <Star class="w-5 h-5 fill-current" />
        <Star class="w-5 h-5 fill-current" />
        <Star class="w-5 h-5 fill-current" />
        <Star class="w-5 h-5 fill-current" />
        <Star class="w-5 h-5 fill-current" />
      </div>
      <p class="italic text-gray-700 mb-6">"Aquí irá la reseña real de Airbnb/Booking destacando la limpieza, las vistas o la atención de Iván."</p>
      <p class="font-semibold text-[#0A2342]">Nombre del Huésped</p>
      <p class="text-sm text-gray-500">Huésped en Airbnb - 5/5</p>
    </div>
  </div>
</section>

