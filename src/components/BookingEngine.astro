---
import { 
  Calendar as CalendarIcon, 
  Users, 
  ShieldCheck, 
  Clock, 
  CheckCircle, 
  Lock,
  ArrowRight,
  MessageCircle,
  Sparkles,
  FileText
} from 'lucide-astro';
import { SITE_CONFIG } from '../config/site';
---

<section id="reservas" class="py-20 lg:py-28 bg-[#FDFBF7] border-t border-stone-200/60 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Editorial Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="text-stone-500 text-xs sm:text-sm tracking-widest uppercase font-medium" data-i18n="bookingPill">
        Reserva Directa Oficial
      </span>
      <h2 class="font-serif text-3xl sm:text-5xl font-normal text-stone-900 tracking-tight mt-3 mb-4" data-i18n="bookingTitle">
        Asegura tu estancia en Suances
      </h2>
      <p class="text-stone-600 text-base sm:text-lg font-light leading-relaxed" data-i18n="bookingDesc">
        Mejor tarifa garantizada sin comisiones de Airbnb ni Booking. Sincronización en tiempo real y confirmación inmediata.
      </p>
    </div>

    <!-- Luxury Floating Card Container -->
    <div class="max-w-4xl mx-auto bg-white shadow-[0_20px_60px_-15px_rgba(0,0,0,0.06)] border border-stone-200/80 rounded-3xl p-6 sm:p-10 lg:p-12">
      
      <!-- Top Subtle Guarantee Banner -->
      <div class="mb-8 pb-6 border-b border-stone-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-stone-50 border border-stone-200/60 text-stone-900 flex items-center justify-center flex-shrink-0">
            <ShieldCheck class="w-5 h-5 stroke-[1.25]" />
          </div>
          <div>
            <span class="block text-sm font-medium text-stone-900" data-i18n="bookingRateNotice">Tarifa Oficial Directa (-10%)</span>
            <span class="block text-xs text-stone-500 font-normal" data-i18n="bookingRateSub">Sin comisiones de agencias intermediarias</span>
          </div>
        </div>

        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-stone-50 border border-stone-200/60 text-xs text-stone-600 font-normal">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span data-i18n="bookingIcalActive">iCal activo en tiempo real</span>
        </div>
      </div>

      <!-- Interactive Form Container -->
      <form id="booking-form" class="space-y-8">
        
        <!-- Step 1: Fechas y Huéspedes -->
        <div>
          <div class="flex items-center gap-2 mb-4">
            <span class="w-6 h-6 rounded-full bg-stone-900 text-white flex items-center justify-center text-xs font-medium">1</span>
            <h3 class="font-serif text-lg sm:text-xl text-stone-900 font-normal tracking-tight" data-i18n="step1Title">Fechas y Huéspedes</h3>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            
            <!-- Selector Fechas -->
            <div class="md:col-span-2">
              <label for="date-range-picker" class="block text-xs font-medium text-stone-700 mb-1.5" data-i18n="lblDates">
                Fechas de Entrada y Salida (Mínimo 2 noches)
              </label>
              <div class="relative">
                <input 
                  type="text" 
                  id="date-range-picker" 
                  name="dates"
                  aria-label="Seleccionar fechas de entrada y salida"
                  placeholder="Selecciona fecha de entrada y salida..." 
                  class="w-full pl-11 pr-4 py-3.5 rounded-2xl border border-stone-200 focus:border-stone-900 focus:ring-2 focus:ring-stone-900/10 text-sm font-medium text-stone-900 bg-stone-50/50 cursor-pointer transition"
                  readonly
                  required
                />
                <CalendarIcon class="w-5 h-5 text-stone-500 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none stroke-[1.5]" />
              </div>
              <p id="calendar-sync-notice" class="text-[11px] text-stone-500 mt-1.5 font-normal">
                Consultando disponibilidad en tiempo real...
              </p>
            </div>

            <!-- Huéspedes -->
            <div>
              <label for="guests-select" class="block text-xs font-medium text-stone-700 mb-1.5" data-i18n="lblGuests">
                Número de Huéspedes
              </label>
              <div class="relative">
                <select 
                  id="guests-select" 
                  name="guests"
                  class="w-full pl-11 pr-8 py-3.5 rounded-2xl border border-stone-200 focus:border-stone-900 focus:ring-2 focus:ring-stone-900/10 text-sm font-medium text-stone-900 bg-stone-50/50 appearance-none transition"
                >
                  <option value="1">1 Huésped</option>
                  <option value="2" selected>2 Huéspedes</option>
                  <option value="3">3 Huéspedes</option>
                  <option value="4">4 Huéspedes</option>
                  <option value="5">5 Huéspedes</option>
                  <option value="6">6 Huéspedes (Máximo)</option>
                </select>
                <Users class="w-5 h-5 text-stone-500 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none stroke-[1.5]" />
              </div>
              <p class="text-[11px] text-stone-500 mt-1.5 font-normal">Capacidad máxima: 6 personas</p>
            </div>

          </div>
        </div>

        <!-- Step 2: Método de Pago (Vía A y Vía B) -->
        <div>
          <div class="flex items-center gap-2 mb-4">
            <span class="w-6 h-6 rounded-full bg-stone-900 text-white flex items-center justify-center text-xs font-medium">2</span>
            <h3 class="font-serif text-lg sm:text-xl text-stone-900 font-normal tracking-tight" data-i18n="step2Title">Modalidad de Pago</h3>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            
            <!-- Tarjeta 1 (Online): Tarjeta Bancaria -->
            <label class="payment-method-card relative flex flex-col p-5 rounded-2xl border-2 border-slate-900 bg-stone-50/70 cursor-pointer transition">
              <div class="flex items-start justify-between">
                <div class="flex items-center gap-3">
                  <input type="radio" name="paymentMethod" value="stripe" checked class="w-4 h-4 text-slate-900 focus:ring-slate-900" />
                  <span class="font-medium text-stone-900 text-base" data-i18n="viaATitle">Tarjeta Bancaria (Crédito / Débito)</span>
                </div>
                <span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded-full uppercase tracking-wider" data-i18n="viaABadge">
                  CONFIRMACIÓN INMEDIATA
                </span>
              </div>
              <p class="text-xs text-stone-600 font-normal mt-2.5 mb-3 leading-relaxed" data-i18n="viaADesc">
                Pasarela segura Stripe con cifrado SSL. Pagas únicamente el 50% de anticipo para bloquear tus fechas al instante.
              </p>
              <div class="mt-auto flex items-center gap-2 text-[11px] text-stone-500 font-normal pt-3 border-t border-stone-200/60">
                <Lock class="w-3.5 h-3.5 text-stone-600 stroke-[1.5]" />
                <span>Cifrado SSL 256-bit • Confirmación en el acto</span>
              </div>
            </label>

            <!-- Tarjeta 2 (Manual): Bizum o Transferencia Bancaria -->
            <label class="payment-method-card relative flex flex-col p-5 rounded-2xl border-2 border-stone-200 bg-white cursor-pointer hover:border-stone-300 transition">
              <div class="flex items-start justify-between">
                <div class="flex items-center gap-3">
                  <input type="radio" name="paymentMethod" value="transfer_manual" class="w-4 h-4 text-slate-900 focus:ring-slate-900" />
                  <span class="font-medium text-stone-900 text-base" data-i18n="viaBTitle">Bizum o Transferencia Bancaria</span>
                </div>
                <span class="px-2 py-0.5 bg-amber-100 text-amber-900 text-[10px] font-bold rounded-full uppercase tracking-wider" data-i18n="viaBBadge">
                  BLOQUEO 2 HORAS
                </span>
              </div>
              <p class="text-xs text-stone-600 font-normal mt-2.5 mb-2 leading-relaxed" data-i18n="viaBDesc">
                Te guardamos las fechas 120 minutos. Envías el Bizum del anticipo al móvil del anfitrión y nos remites el comprobante por WhatsApp.
              </p>
              <!-- Micro-copy tranquilizador -->
              <div class="p-2.5 rounded-xl bg-stone-100/80 border border-stone-200/70 text-[11px] text-stone-700 leading-relaxed mb-3" data-i18n="viaBNotice">
                💡 <strong>No pagarás nada ahora:</strong> Tus fechas quedan reservadas 120 minutos mientras nos envías el comprobante del 50% por WhatsApp.
              </div>
              <div class="mt-auto flex items-center gap-2 text-[11px] text-stone-500 font-normal pt-2 border-t border-stone-200/60">
                <Clock class="w-3.5 h-3.5 text-stone-600 stroke-[1.5]" />
                <span>Bloqueo temporal 120 min • Comprobante por WhatsApp</span>
              </div>
            </label>

          </div>
        </div>

        <!-- Step 3: Datos de Contacto del Huésped -->
        <div>
          <div class="flex items-center gap-2 mb-4">
            <span class="w-6 h-6 rounded-full bg-stone-900 text-white flex items-center justify-center text-xs font-medium">3</span>
            <h3 class="font-serif text-lg sm:text-xl text-stone-900 font-normal tracking-tight" data-i18n="step3Title">Datos del Huésped</h3>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label for="guest-name" class="block text-xs font-medium text-stone-700 mb-1" data-i18n="lblName">Nombre y Apellidos</label>
              <input 
                type="text" 
                id="guest-name" 
                name="name"
                autocomplete="name"
                placeholder="Ej. María García" 
                class="w-full px-4 py-3 rounded-2xl border border-stone-200 focus:border-stone-900 focus:ring-2 focus:ring-stone-900/10 text-sm font-medium bg-stone-50/50"
                required
              />
            </div>
            <div>
              <label for="guest-email" class="block text-xs font-medium text-stone-700 mb-1" data-i18n="lblEmail">Correo Electrónico</label>
              <input 
                type="email" 
                id="guest-email" 
                name="email"
                autocomplete="email"
                placeholder="maria@ejemplo.com" 
                class="w-full px-4 py-3 rounded-2xl border border-stone-200 focus:border-stone-900 focus:ring-2 focus:ring-stone-900/10 text-sm font-medium bg-stone-50/50"
                required
              />
            </div>
            <div>
              <label for="guest-phone" class="block text-xs font-medium text-stone-700 mb-1" data-i18n="lblPhone">Teléfono Móvil (WhatsApp)</label>
              <input 
                type="tel" 
                id="guest-phone" 
                name="phone"
                autocomplete="tel"
                placeholder="+34 600 000 000" 
                class="w-full px-4 py-3 rounded-2xl border border-stone-200 focus:border-stone-900 focus:ring-2 focus:ring-stone-900/10 text-sm font-medium bg-stone-50/50"
                required
              />
            </div>
          </div>

          <!-- Selector de Solicitud de Factura Legal (Empresa / Autónomo) -->
          <div class="mt-4 pt-4 border-t border-stone-200/60">
            <label for="invoice-toggle" class="inline-flex items-center gap-3 cursor-pointer select-none group">
              <input 
                type="checkbox" 
                id="invoice-toggle" 
                name="invoiceRequested"
                onchange="window.__toggleInvoiceFields ? window.__toggleInvoiceFields(this.checked) : null"
                class="w-4 h-4 rounded border-stone-300 text-slate-900 focus:ring-slate-900 cursor-pointer"
              />
              <span class="text-xs sm:text-sm font-medium text-stone-700 group-hover:text-stone-900 transition flex items-center gap-1.5">
                <FileText class="w-4 h-4 text-stone-500 stroke-[1.5]" />
                ¿Necesitas factura para empresa o autónomo?
              </span>
            </label>

            <!-- Despliegue de Datos Fiscales con Transición Suave -->
            <div 
              id="invoice-fields" 
              class="hidden opacity-0 -translate-y-2 mt-3 p-4 bg-stone-100/70 border border-stone-200/80 rounded-2xl space-y-3 transition-all duration-300 ease-out"
            >
              <p class="text-xs text-stone-500 font-normal">
                Indica tus datos de facturación para emitir la factura oficial con desglose de IVA y remitírtela por correo:
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for="invoice-company" class="block text-[11px] font-medium text-stone-700 mb-1">
                    Razón Social / Nombre fiscal
                  </label>
                  <input 
                    type="text" 
                    id="invoice-company" 
                    name="invoiceCompanyName"
                    placeholder="Ej. Empresa S.L. o Nombre fiscal"
                    class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:border-stone-900 focus:ring-2 focus:ring-stone-900/10 text-xs font-medium bg-white"
                  />
                </div>
                <div>
                  <label for="invoice-tax-id" class="block text-[11px] font-medium text-stone-700 mb-1">
                    NIF / CIF / VAT
                  </label>
                  <input 
                    type="text" 
                    id="invoice-tax-id" 
                    name="invoiceTaxId"
                    placeholder="Ej. B12345678 / 12345678Z"
                    class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:border-stone-900 focus:ring-2 focus:ring-stone-900/10 text-xs font-medium bg-white"
                  />
                </div>
              </div>
              <div>
                <label for="invoice-address" class="block text-[11px] font-medium text-stone-700 mb-1">
                  Dirección fiscal completa (Calle, CP, Ciudad, Provincia)
                </label>
                <input 
                  type="text" 
                  id="invoice-address" 
                  name="invoiceAddress"
                  placeholder="Ej. Calle Gran Vía 12, 3ºB, 39001 Santander (Cantabria)"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:border-stone-900 focus:ring-2 focus:ring-stone-900/10 text-xs font-medium bg-white"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- Realtime Price Breakdown Box -->
        <div id="price-summary-box" class="p-6 bg-stone-50 rounded-2xl border border-stone-200/70">
          <div class="flex items-center justify-between pb-3 border-b border-stone-200/60">
            <span class="text-xs uppercase font-medium text-stone-500 tracking-wider" data-i18n="summaryTitle">Desglose de Tarifas</span>
            <span class="text-xs font-medium text-stone-800 bg-white px-2.5 py-0.5 rounded-full border border-stone-200/60" data-i18n="summarySavingsBadge">
              -10% de Ahorro Directo Garantizado
            </span>
          </div>

          <div class="mt-4 space-y-2 text-sm text-stone-600 font-normal">
            <div class="flex justify-between">
              <span id="label-nights">Estancia (<span id="count-nights">0</span> <span id="label-nights-text">noches</span>):</span>
              <span id="val-stay" class="font-medium text-stone-900">— €</span>
            </div>
            <div class="flex justify-between">
              <span data-i18n="summaryCleaning">Limpieza y preparación del apartamento:</span>
              <span class="font-medium text-stone-900">40 €</span>
            </div>
            <div class="flex justify-between text-stone-700 font-medium">
              <span data-i18n="summaryCommissionAvoided">Sobrecoste de comisiones OTA ahorrado:</span>
              <span id="val-savings" class="font-medium">— €</span>
            </div>
          </div>

          <div class="mt-4 pt-4 border-t border-stone-200/60 space-y-3">
            <div class="flex items-baseline justify-between">
              <div>
                <span class="font-serif text-lg sm:text-xl text-stone-900 font-normal tracking-tight" data-i18n="summaryTotal">Total Estancia</span>
                <span class="block text-[11px] text-stone-500 font-normal" data-i18n="summaryIncluded">Impuestos y gastos incluidos</span>
              </div>
              <div class="text-right">
                <span id="val-total" class="font-serif text-2xl sm:text-3xl text-stone-900 font-normal tracking-tight">— €</span>
              </div>
            </div>

            <!-- Desglose de Pago Escalonado (50% anticipo / 50% antes de entrada) -->
            <div class="p-4 rounded-2xl bg-white border border-stone-200/80 shadow-xs space-y-2.5">
              <div class="flex items-center justify-between text-xs sm:text-sm">
                <span class="font-medium text-slate-900 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                  Pago hoy (Anticipo 50% para bloqueo de fechas):
                </span>
                <span id="val-deposit" class="font-bold text-sm sm:text-base text-slate-900">— €</span>
              </div>
              <div class="flex items-center justify-between text-xs sm:text-sm text-stone-600 pt-1.5 border-t border-stone-100">
                <span class="flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-stone-300"></span>
                  Importe restante (50%): a abonar antes de la entrada al alojamiento
                </span>
                <span id="val-remaining" class="font-medium text-stone-800">— €</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Cancellation Badge + Submit Button -->
        <div class="space-y-4">
          <!-- Trust Badge: Free Cancellation 14 días -->
          <div class="p-3.5 rounded-2xl bg-stone-50 border border-stone-200/70 text-stone-700 text-xs sm:text-sm font-medium flex flex-col sm:flex-row items-center justify-center gap-1.5 sm:gap-2 text-center">
            <div class="flex items-center gap-1.5">
              <ShieldCheck class="w-4 h-4 text-stone-700 stroke-[1.5] flex-shrink-0" />
              <span data-i18n="cancelBadge">Cancelación gratuita hasta 14 días antes de la llegada</span>
            </div>
            <span class="hidden sm:inline text-stone-400">•</span>
            <span class="text-[11px] sm:text-xs text-stone-500 font-normal">Anticipo no reembolsable con menos de 14 días</span>
          </div>

          <button 
            type="submit" 
            id="submit-booking-btn"
            disabled
            class="w-full py-4 px-6 rounded-2xl bg-slate-900 hover:bg-slate-800 text-white font-medium text-base shadow-xl shadow-slate-900/10 hover:shadow-slate-900/20 active:translate-y-0.5 transition-all flex items-center justify-center gap-3 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span id="btn-text" data-i18n="btnSelectDates">Selecciona fechas para calcular</span>
            <ArrowRight class="w-4 h-4 stroke-[1.5]" />
          </button>
          
          <!-- Trust Badges & Guarantee Row -->
          <div class="mt-6 pt-6 border-t border-stone-100 grid grid-cols-2 sm:grid-cols-4 gap-4 text-center text-xs text-stone-600 font-normal">
            <div class="p-3 rounded-2xl bg-stone-50 border border-stone-200/50 flex flex-col items-center justify-center gap-1">
              <Lock class="w-4 h-4 text-stone-700 stroke-[1.5]" />
              <span class="font-medium text-stone-900">Stripe Checkout</span>
              <span class="text-[10px] text-stone-500">Cifrado SSL 256-bit</span>
            </div>
            <div class="p-3 rounded-2xl bg-stone-50 border border-stone-200/50 flex flex-col items-center justify-center gap-1">
              <ShieldCheck class="w-4 h-4 text-stone-700 stroke-[1.5]" />
              <span class="font-medium text-stone-900">Sin Comisiones</span>
              <span class="text-[10px] text-stone-500">-10% Ahorro Directo</span>
            </div>
            <div class="p-3 rounded-2xl bg-stone-50 border border-stone-200/50 flex flex-col items-center justify-center gap-1">
              <Clock class="w-4 h-4 text-stone-700 stroke-[1.5]" />
              <span class="font-medium text-stone-900">iCal en Vivo</span>
              <span class="text-[10px] text-stone-500">Booking & Airbnb</span>
            </div>
            <div class="p-3 rounded-2xl bg-stone-50 border border-stone-200/50 flex flex-col items-center justify-center gap-1">
              <MessageCircle class="w-4 h-4 text-stone-700 stroke-[1.5]" />
              <span class="font-medium text-stone-900">Trato Directo</span>
              <span class="text-[10px] text-stone-500">Atención WhatsApp</span>
            </div>
          </div>
        </div>

      </form>
    </div>

  </div>
</section>

<!-- Modal Vía B: Instrucciones de Bloqueo 2h y Pago Manual -->
<div id="manual-booking-modal" class="fixed inset-0 z-50 bg-stone-950/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
  <div class="max-w-lg w-full bg-white rounded-3xl p-6 sm:p-8 shadow-2xl border border-stone-200 text-stone-800 space-y-6">
    
    <!-- Modal Header -->
    <div class="text-center">
      <div class="w-12 h-12 bg-stone-100 text-stone-900 rounded-2xl mx-auto flex items-center justify-center mb-3">
        <Clock class="w-6 h-6 stroke-[1.5]" />
      </div>
      <span class="px-3 py-1 bg-stone-100 text-stone-700 text-xs font-medium rounded-full uppercase tracking-wider">
        Fechas Bloqueadas Temporalmente
      </span>
      <h3 class="font-serif text-2xl font-normal text-stone-900 mt-2 tracking-tight">¡Reserva Pre-confirmada!</h3>
      <p class="text-xs text-stone-500 font-normal mt-1">
        Tus fechas quedan reservadas durante <strong>2 horas</strong> para que envíes el justificante.
      </p>
    </div>

    <!-- Countdown Timer -->
    <div class="bg-stone-50 border border-stone-200 p-4 rounded-2xl text-center">
      <p class="text-xs font-medium text-stone-600">Tiempo restante para completar el pago:</p>
      <div id="timer-display" class="text-3xl font-mono text-stone-900 mt-1 font-medium">
        02:00:00
      </div>
    </div>

    <!-- Bank Details -->
    <div class="space-y-3 bg-stone-50 p-4 rounded-2xl border border-stone-200 text-xs sm:text-sm">
      <div class="flex justify-between items-center py-1 border-b border-stone-200/60">
        <span class="text-stone-500">Referencia:</span>
        <span id="modal-ref" class="font-mono font-medium text-stone-900 text-base">CDS-MAN-XXXX</span>
      </div>
      <div class="flex justify-between items-center py-1 border-b border-stone-200/60">
        <span class="text-stone-500">Total Estancia:</span>
        <span id="modal-total" class="font-serif text-stone-900 font-normal text-base">0 €</span>
      </div>
      <div class="flex justify-between items-center py-1.5 border-b border-emerald-200 bg-emerald-50/70 px-2 rounded-lg">
        <span class="text-emerald-900 font-semibold text-xs sm:text-sm">Anticipo 50% a abonar hoy:</span>
        <span id="modal-deposit" class="font-bold text-emerald-900 text-base sm:text-lg">0 €</span>
      </div>
      <div class="flex justify-between items-center py-1 border-b border-stone-200/60 text-xs">
        <span class="text-stone-500">Restante 50% (antes de entrar):</span>
        <span id="modal-remaining" class="font-medium text-stone-700">0 €</span>
      </div>
      <div class="flex justify-between items-center py-1 border-b border-stone-200/60">
        <span class="text-stone-500">Bizum al móvil:</span>
        <span id="modal-bizum" class="font-medium text-stone-900">+34 600 000 000</span>
      </div>
      <div class="py-1">
        <span class="text-stone-500 block mb-0.5">IBAN Transferencia:</span>
        <span id="modal-iban" class="font-mono font-medium text-stone-900 break-all">ES91 2100 0418 4502 0005 1332</span>
      </div>
    </div>

    <!-- Actions -->
    <div class="space-y-2">
      <a 
        id="modal-whatsapp-link" 
        href="#" 
        target="_blank"
        class="w-full py-3.5 px-4 bg-slate-900 hover:bg-slate-800 text-white font-medium text-sm rounded-2xl text-center flex items-center justify-center gap-2 transition shadow-md"
      >
        <span>Enviar Justificante por WhatsApp</span>
      </a>
      <button 
        type="button" 
        id="modal-close-btn"
        class="w-full py-2.5 px-4 bg-stone-100 hover:bg-stone-200 text-stone-600 font-medium text-xs rounded-2xl transition"
      >
        Cerrar ventana
      </button>
    </div>

  </div>
</div>

<script define:vars={{ whatsappPhone: SITE_CONFIG.whatsappPhone }}>
  import flatpickr from 'flatpickr';
  import { Spanish } from 'flatpickr/dist/l10n/es.js';
  import { calculateStayPricing } from '../config/pricing';

  let checkInDate: string | null = null;
  let checkOutDate: string | null = null;
  let currentCleaningFee = 40;

  const datePickerInput = document.getElementById('date-range-picker') as HTMLInputElement;
  const countNightsEl = document.getElementById('count-nights');
  const valStayEl = document.getElementById('val-stay');
  const valSavingsEl = document.getElementById('val-savings');
  const valTotalEl = document.getElementById('val-total');
  const calendarNoticeEl = document.getElementById('calendar-sync-notice');
  const form = document.getElementById('booking-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-booking-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text');

  // Toggle garantizado con animación de campos de factura legal
  function toggleInvoiceDisplay(isChecked: boolean) {
    const fields = document.getElementById('invoice-fields');
    if (!fields) return;

    if (isChecked) {
      fields.classList.remove('hidden');
      requestAnimationFrame(() => {
        fields.classList.remove('opacity-0', '-translate-y-2');
        fields.classList.add('opacity-100', 'translate-y-0');
      });
    } else {
      fields.classList.remove('opacity-100', 'translate-y-0');
      fields.classList.add('opacity-0', '-translate-y-2');
      setTimeout(() => {
        const toggle = document.getElementById('invoice-toggle') as HTMLInputElement;
        if (!toggle?.checked) {
          fields.classList.add('hidden');
        }
      }, 250);
    }
  }

  (window as any).__toggleInvoiceFields = toggleInvoiceDisplay;

  const invoiceToggle = document.getElementById('invoice-toggle') as HTMLInputElement;
  if (invoiceToggle) {
    invoiceToggle.addEventListener('change', () => toggleInvoiceDisplay(invoiceToggle.checked));
    invoiceToggle.addEventListener('input', () => toggleInvoiceDisplay(invoiceToggle.checked));
    invoiceToggle.addEventListener('click', () => toggleInvoiceDisplay(invoiceToggle.checked));
  }

  // Modal Vía B elements
  const manualModal = document.getElementById('manual-booking-modal');
  const modalCloseBtn = document.getElementById('modal-close-btn');
  const modalRef = document.getElementById('modal-ref');
  const modalTotal = document.getElementById('modal-total');
  const modalDeposit = document.getElementById('modal-deposit');
  const modalRemaining = document.getElementById('modal-remaining');
  const modalBizum = document.getElementById('modal-bizum');
  const modalIban = document.getElementById('modal-iban');
  const modalWhatsappLink = document.getElementById('modal-whatsapp-link') as HTMLAnchorElement;
  const timerDisplay = document.getElementById('timer-display');

  // Estilo visual al cambiar radio de método de pago
  const radioButtons = document.querySelectorAll('input[name="paymentMethod"]');
  radioButtons.forEach((radio) => {
    radio.addEventListener('change', () => {
      document.querySelectorAll('.payment-method-card').forEach((card) => {
        card.classList.remove('border-slate-900', 'bg-stone-50/70');
        card.classList.add('border-stone-200', 'bg-white');
      });
      const parentCard = (radio as HTMLInputElement).closest('.payment-method-card');
      if (parentCard) {
        parentCard.classList.remove('border-stone-200', 'bg-white');
        parentCard.classList.add('border-slate-900', 'bg-stone-50/70');
      }
    });
  });

  // Cálculo de precios mediante matriz estacional y 10% de ahorro directo
  function updatePriceCalculation() {
    const isEn = localStorage.getItem('preferred_lang') === 'en';
    const valDepositEl = document.getElementById('val-deposit');
    const valRemainingEl = document.getElementById('val-remaining');
    const labelNightsText = document.getElementById('label-nights-text');

    if (!checkInDate || !checkOutDate) {
      if (countNightsEl) countNightsEl.textContent = '0';
      if (labelNightsText) labelNightsText.textContent = isEn ? 'nights' : 'noches';
      if (valStayEl) valStayEl.textContent = '— €';
      if (valSavingsEl) valSavingsEl.textContent = '— €';
      if (valTotalEl) valTotalEl.textContent = '— €';
      if (valDepositEl) valDepositEl.textContent = '— €';
      if (valRemainingEl) valRemainingEl.textContent = '— €';
      if (btnText) btnText.textContent = isEn ? 'Select dates to calculate' : 'Selecciona fechas para calcular';
      if (submitBtn) submitBtn.disabled = true;
      return;
    }

    const pricing = calculateStayPricing(checkInDate, checkOutDate);

    if (countNightsEl) countNightsEl.textContent = String(pricing.nights);
    if (labelNightsText) {
      const nightWord = pricing.nights === 1 ? (isEn ? 'noche' : 'noche') : (isEn ? 'nights' : 'noches');
      labelNightsText.textContent = `${nightWord} (media ${pricing.averagePricePerNight}€/noche)`;
    }
    if (valStayEl) valStayEl.textContent = `${pricing.stayTotal} €`;
    if (valSavingsEl) valSavingsEl.textContent = `-${pricing.savingsVsOta} €`;
    if (valTotalEl) valTotalEl.textContent = `${pricing.grandTotal} €`;
    if (valDepositEl) valDepositEl.textContent = `${pricing.depositAmount} €`;
    if (valRemainingEl) valRemainingEl.textContent = `${pricing.remainingAmount} €`;
    if (btnText) {
      btnText.textContent = isEn
        ? `Confirm Booking (Pay ${pricing.depositAmount}€ Deposit)`
        : `Confirmar Reserva (Pagar ${pricing.depositAmount}€ anticipo)`;
    }
    if (submitBtn) submitBtn.disabled = false;
  }

  // Inicializar Flatpickr con disponibilidad del endpoint
  async function initCalendar() {
    let disabledRanges: any[] = [];
    try {
      const res = await fetch('/api/availability.json');
      if (res.ok) {
        const data = await res.json();
        currentCleaningFee = data.cleaningFee || 40;

        if (Array.isArray(data.unavailable)) {
          disabledRanges = data.unavailable.map((item: any) => ({
            from: item.start,
            to: item.end,
          }));
        }
        if (calendarNoticeEl) {
          calendarNoticeEl.innerHTML = `✓ Calendario sincronizado con Booking y Airbnb (${disabledRanges.length} bloqueos)`;
          calendarNoticeEl.classList.remove('text-stone-500');
          calendarNoticeEl.classList.add('text-stone-700', 'font-medium');
        }
      }
    } catch (e) {
      if (calendarNoticeEl) {
        calendarNoticeEl.textContent = 'Calendario activo en modo local.';
      }
    }

    flatpickr(datePickerInput, {
      locale: Spanish,
      mode: 'range',
      minDate: 'today',
      dateFormat: 'Y-m-d',
      altInput: true,
      altFormat: 'j M Y',
      disable: disabledRanges,
      onChange: (selectedDates) => {
        if (selectedDates.length === 2) {
          const d1 = selectedDates[0];
          const d2 = selectedDates[1];

          // Formatear YYYY-MM-DD local
          const formatDate = (d: Date) => {
            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
          };

          checkInDate = formatDate(d1);
          checkOutDate = formatDate(d2);
          updatePriceCalculation();
        } else {
          checkInDate = null;
          checkOutDate = null;
          updatePriceCalculation();
        }
      },
    });
  }

  initCalendar();

  // Gestión del envío del formulario
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!checkInDate || !checkOutDate) {
      alert('Por favor selecciona las fechas de entrada y salida.');
      datePickerInput.focus();
      return;
    }

    const guests = (document.getElementById('guests-select') as HTMLSelectElement).value;
    const guestName = (document.getElementById('guest-name') as HTMLInputElement).value;
    const guestEmail = (document.getElementById('guest-email') as HTMLInputElement).value;
    const guestPhone = (document.getElementById('guest-phone') as HTMLInputElement).value;
    const selectedMethod = (document.querySelector('input[name="paymentMethod"]:checked') as HTMLInputElement)?.value || 'stripe';

    submitBtn.disabled = true;
    if (btnText) btnText.textContent = 'Procesando tu reserva...';

    const invoiceRequested = (document.getElementById('invoice-toggle') as HTMLInputElement)?.checked || false;
    const invoiceCompanyName = (document.getElementById('invoice-company') as HTMLInputElement)?.value.trim() || '';
    const invoiceTaxId = (document.getElementById('invoice-tax-id') as HTMLInputElement)?.value.trim() || '';
    const invoiceAddress = (document.getElementById('invoice-address') as HTMLInputElement)?.value.trim() || '';

    const payload = {
      checkIn: checkInDate,
      checkOut: checkOutDate,
      guests,
      guestName,
      guestEmail,
      guestPhone,
      invoiceRequested,
      invoiceCompanyName,
      invoiceTaxId,
      invoiceAddress,
    };

    try {
      if (selectedMethod === 'stripe') {
        // Vía A: Stripe Checkout
        const response = await fetch('/api/create-checkout-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json();

        if (result.success && result.url) {
          window.location.href = result.url;
        } else {
          alert(result.message || 'Error al iniciar sesión de pago.');
          submitBtn.disabled = false;
          if (btnText) btnText.textContent = 'Confirmar Reserva Directa';
        }
      } else {
        // Vía B: Transferencia Bancaria / Bizum manual
        const response = await fetch('/api/manual-booking', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json();

        if (result.success) {
          // Mostrar modal con datos bancarios y temporizador
          const depositToPay = result.depositAmount || Math.round(result.grandTotal * 0.5);
          const remainingToPay = result.remainingAmount || (result.grandTotal - depositToPay);

          if (modalRef) modalRef.textContent = result.reservationId;
          if (modalTotal) modalTotal.textContent = `${result.grandTotal} €`;
          if (modalDeposit) modalDeposit.textContent = `${depositToPay} €`;
          if (modalRemaining) modalRemaining.textContent = `${remainingToPay} €`;
          if (modalBizum) modalBizum.textContent = result.paymentDetails.bizumPhone;
          if (modalIban) modalIban.textContent = result.paymentDetails.bankIban;

          const whatsappMessage = encodeURIComponent(
            `Hola Ivan, acabo de realizar la pre-reserva directa ${result.reservationId} para el Apartamento Costa del Sol Suances del ${result.checkIn} al ${result.checkOut}. Te adjunto el comprobante del anticipo del 50% (${depositToPay}€ de un total de ${result.grandTotal}€).`
          );
          if (modalWhatsappLink) {
            modalWhatsappLink.href = `https://wa.me/${whatsappPhone}?text=${whatsappMessage}`;
          }

          start2HourTimer(result.expiresAt);
          manualModal?.classList.remove('hidden');
        } else {
          alert(result.message || 'Error al generar la pre-reserva.');
        }
        submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Confirmar Reserva Directa';
      }
    } catch (err) {
      console.error(err);
      alert('Error de conexión con el servidor. Inténtalo de nuevo.');
      submitBtn.disabled = false;
      if (btnText) btnText.textContent = 'Confirmar Reserva Directa';
    }
  });

  // Temporizador de 2 horas regresivo
  function start2HourTimer(expiresAtIso: string) {
    const target = new Date(expiresAtIso).getTime();

    const interval = setInterval(() => {
      const now = Date.now();
      const distance = target - now;

      if (distance <= 0) {
        clearInterval(interval);
        if (timerDisplay) timerDisplay.textContent = '00:00:00 (Caducado)';
        return;
      }

      const hours = Math.floor(distance / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      const pad = (n: number) => String(n).padStart(2, '0');
      if (timerDisplay) {
        timerDisplay.textContent = `${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;
      }
    }, 1000);
  }

  modalCloseBtn?.addEventListener('click', () => {
    manualModal?.classList.add('hidden');
  });
</script>
