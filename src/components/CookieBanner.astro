---
import { ShieldCheck, Cookie, X } from 'lucide-astro';
---

<!-- Cookie Consent Banner (Boutique Style RGPD / LSSI) -->
<div 
  id="cookie-banner" 
  class="fixed bottom-4 sm:bottom-6 inset-x-4 sm:inset-x-auto sm:right-6 sm:max-w-md z-50 bg-[#FDFBF7] border border-stone-300/80 shadow-[0_20px_50px_rgba(15,23,42,0.18)] rounded-3xl p-5 sm:p-6 transition-all duration-500 transform translate-y-24 opacity-0 pointer-events-none"
  role="region"
  aria-label="Consentimiento de cookies"
>
  <div class="flex items-start gap-3.5">
    <div class="w-10 h-10 rounded-2xl bg-slate-900 text-white flex items-center justify-center flex-shrink-0 shadow-md">
      <Cookie class="w-5 h-5 stroke-[1.5]" />
    </div>

    <div class="flex-1">
      <h3 class="font-serif text-base text-stone-900 font-normal tracking-tight" data-i18n="cookieTitle">
        Privacidad & Cookies
      </h3>
      <p class="text-xs text-stone-600 font-normal leading-relaxed mt-1" data-i18n="cookieDesc">
        Utilizamos cookies analíticas anónimas para comprender cómo descubres nuestro apartamento en Suances y ofrecerte la mejor experiencia directa.
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-2">
        <button 
          id="btn-accept-cookies"
          type="button"
          class="px-4 py-2 rounded-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-medium shadow-sm transition active:scale-95 cursor-pointer"
          data-i18n="cookieAccept"
        >
          Aceptar cookies
        </button>

        <button 
          id="btn-reject-cookies"
          type="button"
          class="px-4 py-2 rounded-full bg-stone-100 hover:bg-stone-200 text-stone-700 text-xs font-medium transition active:scale-95 cursor-pointer"
          data-i18n="cookieReject"
        >
          Solo necesarias
        </button>

        <a 
          href="/politica-cookies" 
          class="text-xs text-stone-500 hover:text-stone-900 underline font-normal transition ml-auto"
          data-i18n="cookieLearnMore"
        >
          Saber más
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const banner = document.getElementById('cookie-banner');
  const btnAccept = document.getElementById('btn-accept-cookies');
  const btnReject = document.getElementById('btn-reject-cookies');

  function showBanner() {
    if (banner) {
      banner.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
      banner.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
    }
  }

  function hideBanner() {
    if (banner) {
      banner.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
      banner.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
    }
  }

  // Verificar estado del consentimiento
  const storedConsent = localStorage.getItem('cookie_consent');
  if (!storedConsent) {
    // Mostrar con ligero retraso para suavizar la entrada
    setTimeout(showBanner, 1500);
  }

  btnAccept?.addEventListener('click', () => {
    localStorage.setItem('cookie_consent', 'accepted');
    hideBanner();
    window.dispatchEvent(new CustomEvent('cookie_consent_accepted'));
  });

  btnReject?.addEventListener('click', () => {
    localStorage.setItem('cookie_consent', 'rejected');
    hideBanner();
  });
</script>

