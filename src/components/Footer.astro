---
import { Phone, Mail, MapPin, ShieldCheck } from 'lucide-astro';
import { SITE_CONFIG } from '../config/site';
---

<footer class="bg-slate-900 text-stone-300 pt-20 pb-14 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-14 border-b border-slate-800">
      
      <!-- Brand & Description (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <!-- Brand Logo Tipográfico Boutique -->
        <a href="#inicio" class="inline-flex flex-col group">
          <span class="font-serif tracking-widest text-base uppercase text-white font-normal leading-tight group-hover:text-stone-300 transition">
            COSTA DEL SOL
          </span>
          <span class="text-[9px] tracking-[0.28em] uppercase text-stone-400 font-semibold mt-1">
            SUANCES · CANTABRIA
          </span>
        </a>

        <p class="text-sm text-stone-300 font-normal leading-relaxed max-w-sm" data-i18n="footerDesc">
          Alojamiento boutique frente al mar en Suances, Cantabria. 70 m², 3 dormitorios independientes y reserva directa con la tarifa más ventajosa garantizada sin comisiones de Airbnb ni Booking.
        </p>

        <div class="pt-2 flex items-center gap-2 text-xs text-stone-300 font-normal">
          <ShieldCheck class="w-4 h-4 text-stone-300 stroke-[1.5] flex-shrink-0" />
          <span data-i18n="footerVut">Vivienda de Uso Turístico Oficial — Cantabria ({SITE_CONFIG.touristLicense})</span>
        </div>

        <div class="pt-2 flex flex-col gap-2 text-xs text-stone-400">
          <div class="flex items-center gap-2">
            <MapPin class="w-3.5 h-3.5 text-stone-400 flex-shrink-0 stroke-[1.5]" />
            <span data-i18n="brandLocation">Suances (Playa de La Concha), Cantabria</span>
          </div>
          <div class="flex items-center gap-4 pt-1">
            <a href={SITE_CONFIG.whatsappUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-stone-300 hover:text-white transition">
              <Phone class="w-3.5 h-3.5 stroke-[1.5]" />
              <span>{SITE_CONFIG.whatsappDisplayPhone}</span>
            </a>
            <a href={`mailto:${SITE_CONFIG.hostEmail}`} class="flex items-center gap-1.5 text-stone-300 hover:text-white transition">
              <Mail class="w-3.5 h-3.5 stroke-[1.5]" />
              <span>{SITE_CONFIG.hostEmail}</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Enlaces Rápidos -->
      <div>
        <h4 class="text-xs font-medium uppercase tracking-widest text-stone-200 mb-4" data-i18n="navHome">Navegación</h4>
        <ul class="space-y-2.5 text-sm font-normal text-stone-300">
          <li><a href="#inicio" class="hover:text-white transition" data-i18n="navHome">Inicio</a></li>
          <li><a href="#galeria" class="hover:text-white transition" data-i18n="navGallery">Galería de Fotos</a></li>
          <li><a href="#caracteristicas" class="hover:text-white transition" data-i18n="navRooms">3 Dormitorios & 70 m²</a></li>
          <li><a href="#experiencias" class="hover:text-white transition">Experiencias</a></li>
          <li><a href="#ventajas" class="hover:text-white transition" data-i18n="navPerks">Tarifa Directa</a></li>
          <li><a href="#ubicacion" class="hover:text-white transition" data-i18n="navLocation">Ubicación y Entorno</a></li>
          <li><a href="#reservas" class="text-stone-200 font-medium hover:underline" data-i18n="navBookBtn">Motor de Reservas</a></li>
        </ul>
      </div>

      <!-- Legal / Cumplimiento Normativo -->
      <div>
        <h4 class="text-xs font-medium uppercase tracking-widest text-stone-200 mb-4" data-i18n="footerLegal">Información Legal</h4>
        <ul class="space-y-2.5 text-sm font-normal text-stone-300">
          <li><a href="/aviso-legal" class="hover:text-white transition" data-i18n="footerAviso">Aviso Legal</a></li>
          <li><a href="/politica-privacidad" class="hover:text-white transition" data-i18n="footerPrivacidad">Política de Privacidad</a></li>
          <li><a href="/terminos-condiciones" class="hover:text-white transition" data-i18n="footerTerminos">Términos y Condiciones</a></li>
          <li><a href="/politica-cookies" class="hover:text-white transition" data-i18n="footerCookies">Política de Cookies</a></li>
        </ul>
      </div>

      <!-- Columna 4: Garantía Directa / Reserva Exclusiva -->
      <div>
        <h4 class="text-xs font-medium uppercase tracking-widest text-stone-200 mb-4">Garantía Directa</h4>
        <ul class="space-y-3.5 text-xs text-stone-300">
          <li class="flex items-start gap-2.5">
            <span class="text-sm flex-shrink-0">🐾</span>
            <span class="leading-relaxed">Pet Friendly sin suplemento</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-sm flex-shrink-0">⏱️</span>
            <span class="leading-relaxed">Cancelación gratuita hasta 14 días</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-sm flex-shrink-0">💬</span>
            <span class="leading-relaxed">Trato directo y sin comisiones de agencias</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright Unificado -->
    <div class="pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-400 font-normal">
      <p class="text-center sm:text-left">
        © 2026 Apartamento Costa del Sol Suances. Todos los derechos reservados. · Diseñado por <a href={SITE_CONFIG.designerUrl} target="_blank" rel="noopener noreferrer" class="text-stone-300 hover:text-white font-medium underline underline-offset-4 decoration-stone-600 hover:decoration-white transition">{SITE_CONFIG.designerName}</a>
      </p>
      
      <div>
        <a href="#inicio" class="text-stone-400 hover:text-white transition">Volver arriba ↑</a>
      </div>
    </div>

  </div>
</footer>
