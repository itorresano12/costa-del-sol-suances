---
import { Waves, Github, Phone, Mail, MapPin, ShieldCheck, Download } from 'lucide-astro';
---

<footer class="bg-slate-900 text-stone-300 pt-20 pb-14 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-14 border-b border-slate-800">
      
      <!-- Brand & Description (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <a href="#inicio" class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-white/10 text-white flex items-center justify-center font-bold">
            <Waves class="w-5 h-5 stroke-[1.5]" />
          </div>
          <span class="font-serif text-2xl text-white tracking-tight" data-i18n="brandName">
            Costa del Sol Suances
          </span>
        </a>

        <p class="text-sm text-stone-300 font-normal leading-relaxed max-w-sm" data-i18n="footerDesc">
          Alojamiento boutique frente al mar en Suances, Cantabria. 70 m², 3 dormitorios independientes y reserva directa con la tarifa más ventajosa garantizada sin comisiones de Airbnb ni Booking.
        </p>

        <div class="pt-2 flex items-center gap-2 text-xs text-stone-300 font-normal">
          <ShieldCheck class="w-4 h-4 text-stone-300 stroke-[1.5] flex-shrink-0" />
          <span data-i18n="footerVut">Vivienda de Uso Turístico Oficial — Cantabria (Lic. G-12345/VUT)</span>
        </div>
      </div>

      <!-- Enlaces Rápidos -->
      <div>
        <h4 class="text-xs font-medium uppercase tracking-widest text-stone-200 mb-4" data-i18n="navHome">Navegación</h4>
        <ul class="space-y-2.5 text-sm font-normal text-stone-300">
          <li><a href="#inicio" class="hover:text-white transition" data-i18n="navHome">Inicio</a></li>
          <li><a href="#galeria" class="hover:text-white transition" data-i18n="navGallery">Galería de Fotos</a></li>
          <li><a href="#caracteristicas" class="hover:text-white transition" data-i18n="navRooms">3 Dormitorios & 70 m²</a></li>
          <li><a href="#ventajas" class="hover:text-white transition" data-i18n="navPerks">Tarifa Directa</a></li>
          <li><a href="#ubicacion" class="hover:text-white transition" data-i18n="navLocation">Ubicación y Entorno</a></li>
          <li><a href="#reservas" class="text-stone-200 font-medium hover:underline" data-i18n="navBookBtn">Motor de Reservas</a></li>
        </ul>
      </div>

      <!-- Legal / Cumplimiento Normativo -->
      <div>
        <h4 class="text-xs font-medium uppercase tracking-widest text-stone-200 mb-4" data-i18n="footerLegal">Información Legal</h4>
        <ul class="space-y-2.5 text-sm font-normal text-stone-300">
          <li><a href="/aviso-legal" class="hover:text-white transition" data-i18n="footerAviso">Aviso Legal</a></li>
          <li><a href="/politica-privacidad" class="hover:text-white transition" data-i18n="footerPrivacidad">Política de Privacidad</a></li>
          <li><a href="/terminos-condiciones" class="hover:text-white transition" data-i18n="footerTerminos">Términos y Condiciones</a></li>
          <li><a href="/politica-cookies" class="hover:text-white transition" data-i18n="footerCookies">Política de Cookies</a></li>
        </ul>
      </div>

      <!-- Contacto Directo & iCal -->
      <div>
        <h4 class="text-xs font-medium uppercase tracking-widest text-stone-200 mb-4">Contacto Directo</h4>
        <ul class="space-y-3 text-sm font-normal text-stone-300">
          <li class="flex items-start gap-2.5">
            <MapPin class="w-4 h-4 text-stone-400 flex-shrink-0 mt-0.5 stroke-[1.5]" />
            <span data-i18n="brandLocation">Suances (Playa de La Concha), Cantabria</span>
          </li>
          <li class="flex items-center gap-2.5">
            <Phone class="w-4 h-4 text-stone-400 flex-shrink-0 stroke-[1.5]" />
            <a href="https://wa.me/34600123456" target="_blank" class="hover:text-white transition">
              +34 600 123 456 (WhatsApp)
            </a>
          </li>
          <li class="flex items-center gap-2.5">
            <Mail class="w-4 h-4 text-stone-400 flex-shrink-0 stroke-[1.5]" />
            <a href="mailto:info@costadelsolsuances.es" class="hover:text-white transition">
              info@costadelsolsuances.es
            </a>
          </li>
        </ul>

        <!-- Sincronización iCal -->
        <div class="mt-6 pt-4 border-t border-slate-800">
          <span class="block text-[11px] uppercase tracking-widest text-stone-400 font-medium mb-1.5">Sincronización iCal</span>
          <a 
            href="/api/calendar.ics" 
            target="_blank"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-800/80 border border-slate-700 text-xs text-stone-200 hover:text-white hover:border-slate-500 transition"
          >
            <Download class="w-3.5 h-3.5 stroke-[1.5]" />
            <span>Feed /api/calendar.ics</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & GitHub Profile Reference -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-400 font-normal">
      <p>© {new Date().getFullYear()} Apartamento Costa del Sol Suances (Cantabria). Todos los derechos reservados.</p>
      
      <div class="flex items-center gap-4">
        <a 
          href="https://github.com/itorresano12" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-stone-300 hover:text-white transition"
        >
          <Github class="w-3.5 h-3.5 stroke-[1.5]" />
          <span>@itorresano12</span>
        </a>
        <span>•</span>
        <a href="#inicio" class="hover:text-stone-200 transition">Volver arriba ↑</a>
      </div>
    </div>

  </div>
</footer>
