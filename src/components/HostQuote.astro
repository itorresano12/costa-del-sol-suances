---
import { Waves } from 'lucide-astro';
---

<section class="py-16 sm:py-20 bg-[#FDFBF7] border-t border-stone-200/60 text-center relative overflow-hidden">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="inline-flex items-center gap-2 text-stone-500 text-xs sm:text-sm tracking-widest uppercase font-medium mb-5">
      <Waves class="w-4 h-4 text-stone-700 stroke-[1.5]" />
      <span>Hospitalidad Cántabra</span>
    </div>

    <blockquote class="font-serif italic text-2xl sm:text-4xl text-stone-900 leading-snug font-normal tracking-tight max-w-2xl mx-auto">
      “Una casa cuidada frente al mar para saborear el norte sin prisas.”
    </blockquote>

    <div class="mt-6 flex flex-col items-center">
      <div class="h-0.5 w-12 bg-stone-300 rounded-full mb-3"></div>
      <p class="text-xs sm:text-sm uppercase tracking-widest text-stone-600 font-medium">
        — Ivan, tu anfitrión
      </p>
      <span class="text-[11px] text-stone-500 font-normal mt-0.5">Apartamento Costa del Sol · Suances</span>
    </div>
  </div>
</section>

