---
import { 
  BedDouble, 
  Bath, 
  Coffee, 
  Tv, 
  Wifi, 
  Wind, 
  Refrigerator, 
  Sun,
  Flame,
  UtensilsCrossed,
  Sparkles
} from 'lucide-astro';
---

<section id="caracteristicas" class="py-20 lg:py-28 bg-[#FDFBF7] border-t border-stone-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header Editorial -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-stone-500 text-xs sm:text-sm tracking-widest uppercase font-medium">
        Espacio & Arquitectura
      </span>
      <h2 class="font-serif text-3xl sm:text-5xl font-normal text-stone-900 tracking-tight mt-3 mb-4">
        70 m² concebidos para el reposo
      </h2>
      <p class="text-stone-600 text-base sm:text-lg font-light leading-relaxed">
        Luz natural cántabra, materiales acogedores y una distribución diáfana que invita a desconectar junto al mar.
      </p>
    </div>

    <!-- The 3 Bedrooms (Clean & Serene Showcase) -->
    <div class="mb-20">
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-stone-200/70">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl text-stone-900 font-normal">
            Los Tres Dormitorios
          </h3>
          <p class="text-xs sm:text-sm text-stone-500 font-light mt-1">
            Capacidad para albergar con holgura hasta 6 huéspedes en 3 estancias privadas.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Dormitorio 1 -->
        <div class="bg-white rounded-3xl overflow-hidden border border-stone-200/80 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] group flex flex-col">
          <div class="h-56 overflow-hidden bg-stone-100">
            <img 
              src="/images/apartamento/dormitorio-principal.jpg" 
              alt="Dormitorio principal con cama de matrimonio de 150 cm" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
          </div>
          <div class="p-6 sm:p-7 flex flex-col flex-1">
            <span class="text-xs tracking-widest uppercase text-stone-400 font-medium">Dormitorio Principal</span>
            <h4 class="font-serif text-xl sm:text-2xl text-stone-900 font-normal mt-1 mb-3">
              Cama de Matrimonio de 150 cm
            </h4>
            <p class="text-stone-600 text-sm font-light leading-relaxed mb-6 flex-1">
              Colchón de alto confort con ropa de cama de algodón puro, amplio armario para guardar tu equipaje y agradable luz de mañana.
            </p>
            <div class="pt-4 border-t border-stone-100 text-xs text-stone-500 font-light flex items-center justify-between">
              <span>Cama 150 × 190 cm</span>
              <span>•</span>
              <span>Ropa de cama incluida</span>
            </div>
          </div>
        </div>

        <!-- Dormitorio 2 -->
        <div class="bg-white rounded-3xl overflow-hidden border border-stone-200/80 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] group flex flex-col">
          <div class="h-56 overflow-hidden bg-stone-100">
            <img 
              src="/images/apartamento/dormitorio-2.jpg" 
              alt="Segundo dormitorio con dos camas individuales confortables" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
          </div>
          <div class="p-6 sm:p-7 flex flex-col flex-1">
            <span class="text-xs tracking-widest uppercase text-stone-400 font-medium">Segundo Dormitorio</span>
            <h4 class="font-serif text-xl sm:text-2xl text-stone-900 font-normal mt-1 mb-3">
              Dos Camas Individuales
            </h4>
            <p class="text-stone-600 text-sm font-light leading-relaxed mb-6 flex-1">
              Dos camas independientes de 90 cm con colchones ergonómicos. Idóneo para estancias con niños, amigos o para un descanso sosegado.
            </p>
            <div class="pt-4 border-t border-stone-100 text-xs text-stone-500 font-light flex items-center justify-between">
              <span>2 camas de 90 cm</span>
              <span>•</span>
              <span>Gran luminosidad</span>
            </div>
          </div>
        </div>

        <!-- Dormitorio 3 -->
        <div class="bg-white rounded-3xl overflow-hidden border border-stone-200/80 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] group flex flex-col">
          <div class="h-56 overflow-hidden bg-stone-100">
            <img 
              src="/images/apartamento/dormitorio-3.jpg" 
              alt="Tercer dormitorio independiente con cama nido" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
          </div>
          <div class="p-6 sm:p-7 flex flex-col flex-1">
            <span class="text-xs tracking-widest uppercase text-stone-400 font-medium">Tercer Dormitorio</span>
            <h4 class="font-serif text-xl sm:text-2xl text-stone-900 font-normal mt-1 mb-3">
              Habitación Nido Privada
            </h4>
            <p class="text-stone-600 text-sm font-light leading-relaxed mb-6 flex-1">
              Estancia independiente que asegura intimidad y descanso para un quinto o sexto huésped, con ventilación agradable y silenciosa.
            </p>
            <div class="pt-4 border-t border-stone-100 text-xs text-stone-500 font-light flex items-center justify-between">
              <span>Cama 90 cm convertible</span>
              <span>•</span>
              <span>Máxima privacidad</span>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Salón, Cocina y Baño -->
    <div class="mb-20">
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-stone-200/70">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl text-stone-900 font-normal">
            Zonas Comunes & Equipamiento
          </h3>
          <p class="text-xs sm:text-sm text-stone-500 font-light mt-1">
            Todas las comodidades del hogar junto a la costa cántabra.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Salón -->
        <div class="bg-white rounded-3xl p-8 border border-stone-200/80 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-stone-50 border border-stone-200/60 text-stone-900 flex items-center justify-center mb-6">
              <Tv class="w-6 h-6 stroke-[1.25]" />
            </div>
            <h4 class="font-serif text-xl sm:text-2xl text-stone-900 font-normal mb-3">
              Salón con Vistas al Mar
            </h4>
            <p class="text-stone-600 text-sm font-light leading-relaxed mb-4">
              Espacio diáfano y cálido con sofá amplio, mesa de comedor familiar para 6 personas, Smart TV y luz marina durante todo el día.
            </p>
          </div>
          <div class="pt-4 border-t border-stone-100 text-xs text-stone-400 font-light">
            Smart TV · Mesa de comedor · Luz natural
          </div>
        </div>

        <!-- Cocina -->
        <div class="bg-white rounded-3xl p-8 border border-stone-200/80 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-stone-50 border border-stone-200/60 text-stone-900 flex items-center justify-center mb-6">
              <Coffee class="w-6 h-6 stroke-[1.25]" />
            </div>
            <h4 class="font-serif text-xl sm:text-2xl text-stone-900 font-normal mb-3">
              Cocina Totalmente Equipada
            </h4>
            <p class="text-stone-600 text-sm font-light leading-relaxed mb-4">
              Para desayunar o preparar recetas con productos del mar: <strong>nevera combi grande</strong>, <strong>cafetera</strong>, microondas, vitrocerámica y menaje completo.
            </p>
          </div>
          <div class="pt-4 border-t border-stone-100 text-xs text-stone-400 font-light">
            Nevera grande · Cafetera · Microondas · Menaje
          </div>
        </div>

        <!-- Baño -->
        <div class="bg-white rounded-3xl p-8 border border-stone-200/80 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-stone-50 border border-stone-200/60 text-stone-900 flex items-center justify-center mb-6">
              <Bath class="w-6 h-6 stroke-[1.25]" />
            </div>
            <h4 class="font-serif text-xl sm:text-2xl text-stone-900 font-normal mb-3">
              Baño con Ducha y Secador
            </h4>
            <p class="text-stone-600 text-sm font-light leading-relaxed mb-4">
              Plato de ducha amplio con mampara, agua caliente continua, <strong>secador de pelo</strong>, espejo iluminado y juego de toallas de calidad.
            </p>
          </div>
          <div class="pt-4 border-t border-stone-100 text-xs text-stone-400 font-light">
            Plato de ducha · Secador potente · Toallas
          </div>
        </div>

      </div>
    </div>

    <!-- Minimalist Amenities Bar -->
    <div class="bg-white rounded-3xl p-8 sm:p-10 border border-stone-200/80 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
      <h3 class="font-serif text-xl sm:text-2xl text-stone-900 font-normal text-center mb-8">
        Detalles incluidos para una estancia perfecta
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-6 text-center">
        <div class="flex flex-col items-center">
          <Wifi class="w-5 h-5 text-stone-700 stroke-[1.5] mb-2" />
          <span class="text-xs font-medium text-stone-900">WiFi Fibra Óptica</span>
          <span class="text-[11px] text-stone-400 font-light">Gratuito</span>
        </div>
        <div class="flex flex-col items-center">
          <Sun class="w-5 h-5 text-stone-700 stroke-[1.5] mb-2" />
          <span class="text-xs font-medium text-stone-900">Playa La Concha</span>
          <span class="text-[11px] text-stone-400 font-light">2 min a pie</span>
        </div>
        <div class="flex flex-col items-center">
          <Coffee class="w-5 h-5 text-stone-700 stroke-[1.5] mb-2" />
          <span class="text-xs font-medium text-stone-900">Cafetera</span>
          <span class="text-[11px] text-stone-400 font-light">Para tus mañanas</span>
        </div>
        <div class="flex flex-col items-center">
          <Wind class="w-5 h-5 text-stone-700 stroke-[1.5] mb-2" />
          <span class="text-xs font-medium text-stone-900">Secador de Pelo</span>
          <span class="text-[11px] text-stone-400 font-light">Potente</span>
        </div>
        <div class="flex flex-col items-center">
          <Refrigerator class="w-5 h-5 text-stone-700 stroke-[1.5] mb-2" />
          <span class="text-xs font-medium text-stone-900">Nevera Grande</span>
          <span class="text-[11px] text-stone-400 font-light">Con congelador</span>
        </div>
        <div class="flex flex-col items-center">
          <Flame class="w-5 h-5 text-stone-700 stroke-[1.5] mb-2" />
          <span class="text-xs font-medium text-stone-900">Calefacción</span>
          <span class="text-[11px] text-stone-400 font-light">Confort térmico</span>
        </div>
      </div>
    </div>

  </div>
</section>
