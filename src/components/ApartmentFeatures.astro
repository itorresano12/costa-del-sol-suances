---
import { 
  BedDouble, 
  Bath, 
  Coffee, 
  Tv, 
  Wifi, 
  Wind, 
  Refrigerator, 
  Sun,
  Flame,
  Baby,
  Heart
} from 'lucide-astro';
---

<section id="caracteristicas" class="py-20 lg:py-28 bg-[#FDFBF7] border-t border-stone-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header Editorial -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-stone-500 text-xs sm:text-sm tracking-widest uppercase font-medium" data-i18n="featPill">
        Espacio & Arquitectura
      </span>
      <h2 class="font-serif text-3xl sm:text-5xl font-normal text-stone-900 tracking-tight mt-3 mb-4" data-i18n="featTitle">
        70 m² concebidos para el reposo
      </h2>
      <p class="text-stone-600 text-base sm:text-lg font-light leading-relaxed" data-i18n="featDesc">
        Luz natural cántabra, materiales acogedores y tres dormitorios independientes para descansar junto al mar.
      </p>
    </div>

    <!-- The 3 Bedrooms (Clean & Accurate Photographic Showcase) -->
    <div class="mb-20">
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-stone-200/70">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl text-stone-900 font-normal tracking-tight" data-i18n="featRoomsTitle">
            Los Tres Dormitorios
          </h3>
          <p class="text-xs sm:text-sm text-stone-600 font-normal mt-1" data-i18n="featRoomsSub">
            Distribución versátil con capacidad real para hasta 6 personas y cuna de viaje.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Dormitorio 1: Master con Cama 150cm -->
        <div class="bg-white rounded-3xl overflow-hidden border border-stone-200/80 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] group flex flex-col">
          <div class="h-60 overflow-hidden bg-stone-100">
            <img 
              src="/images/apartamento/edificio-exterior.jpg" 
              alt="Dormitorio principal con cama de matrimonio de 150 cm, cabecero tapizado y textiles de calidad" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
          </div>
          <div class="p-6 sm:p-7 flex flex-col flex-1">
            <span class="text-xs tracking-widest uppercase text-stone-500 font-medium">Dormitorio Principal</span>
            <h4 class="font-serif text-xl sm:text-2xl text-stone-900 font-normal mt-1 mb-3 tracking-tight" data-i18n="room1Title">
              Cama de Matrimonio de 150 cm
            </h4>
            <p class="text-stone-600 text-sm font-normal leading-relaxed mb-6 flex-1" data-i18n="room1Desc">
              Colchón de alto confort con ropa de cama de algodón 100%, ventilador de techo de madera de diseño, toallas limpias y armario empotrado.
            </p>
            <div class="pt-4 border-t border-stone-100 text-xs text-stone-600 font-medium flex items-center justify-between">
              <span>Cama 150 × 190 cm</span>
              <span>•</span>
              <span>Ventilador de techo</span>
            </div>
          </div>
        </div>

        <!-- Dormitorio 2: Habitación Doble Confort -->
        <div class="bg-white rounded-3xl overflow-hidden border border-stone-200/80 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] group flex flex-col">
          <div class="h-60 overflow-hidden bg-stone-100">
            <img 
              src="/images/apartamento/bano.jpg" 
              alt="Segundo dormitorio con cama doble, textiles suaves y ventilador de techo" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
          </div>
          <div class="p-6 sm:p-7 flex flex-col flex-1">
            <span class="text-xs tracking-widest uppercase text-stone-500 font-medium">Segundo Dormitorio</span>
            <h4 class="font-serif text-xl sm:text-2xl text-stone-900 font-normal mt-1 mb-3 tracking-tight" data-i18n="room2Title">
              Habitación Doble Confort
            </h4>
            <p class="text-stone-600 text-sm font-normal leading-relaxed mb-6 flex-1" data-i18n="room2Desc">
              Cama amplia con manta suave, cojines de terciopelo azul marino, ventilador de techo de madera, armario ropero y mesilla de noche.
            </p>
            <div class="pt-4 border-t border-stone-100 text-xs text-stone-600 font-medium flex items-center justify-between">
              <span>Cama doble confortable</span>
              <span>•</span>
              <span>Cuna de viaje disponible</span>
            </div>
          </div>
        </div>

        <!-- Dormitorio 3: Literas de Madera Natural -->
        <div class="bg-white rounded-3xl overflow-hidden border border-stone-200/80 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] group flex flex-col">
          <div class="h-60 overflow-hidden bg-stone-100">
            <img 
              src="/images/apartamento/entorno-playa.jpg" 
              alt="Tercer dormitorio con literas de madera natural y armario con espejo" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
          </div>
          <div class="p-6 sm:p-7 flex flex-col flex-1">
            <span class="text-xs tracking-widest uppercase text-stone-500 font-medium">Tercer Dormitorio</span>
            <h4 class="font-serif text-xl sm:text-2xl text-stone-900 font-normal mt-1 mb-3 tracking-tight" data-i18n="room3Title">
              Literas de Madera Maciza
            </h4>
            <p class="text-stone-600 text-sm font-normal leading-relaxed mb-6 flex-1" data-i18n="room3Desc">
              Dos camas individuales de 90 cm en estructura robusta de madera, ideal para niños, amigos o acompañantes. Gran armario con espejo.
            </p>
            <div class="pt-4 border-t border-stone-100 text-xs text-stone-600 font-medium flex items-center justify-between">
              <span>2 camas de 90 × 190 cm</span>
              <span>•</span>
              <span>Armario con espejo</span>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Salón, Cocina y Baño -->
    <div class="mb-20">
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-stone-200/70">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl text-stone-900 font-normal tracking-tight" data-i18n="commonAreasTitle">
            Zonas Comunes & Equipamiento
          </h3>
          <p class="text-xs sm:text-sm text-stone-600 font-normal mt-1">
            Todas las comodidades del hogar junto a la costa cántabra.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Salón -->
        <div class="bg-white rounded-3xl p-8 border border-stone-200/80 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-stone-50 border border-stone-200/60 text-stone-900 flex items-center justify-center mb-6">
              <Tv class="w-6 h-6 stroke-[1.25]" />
            </div>
            <h4 class="font-serif text-xl sm:text-2xl text-stone-900 font-normal mb-3 tracking-tight" data-i18n="livingTitle">
              Salón Diáfano y Luminoso
            </h4>
            <p class="text-stone-600 text-sm font-normal leading-relaxed mb-4" data-i18n="livingDesc">
              Sofá amplio chaise longue, Smart TV, mesa de comedor familiar para 6 personas, ventilador de techo y luz natural exterior.
            </p>
          </div>
          <div class="pt-4 border-t border-stone-100 text-xs text-stone-500 font-medium">
            Smart TV · Mesa 6 comensales · Luz natural
          </div>
        </div>

        <!-- Cocina -->
        <div class="bg-white rounded-3xl p-8 border border-stone-200/80 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-stone-50 border border-stone-200/60 text-stone-900 flex items-center justify-center mb-6">
              <Coffee class="w-6 h-6 stroke-[1.25]" />
            </div>
            <h4 class="font-serif text-xl sm:text-2xl text-stone-900 font-normal mb-3 tracking-tight" data-i18n="kitchenTitle">
              Cocina Totalmente Equipada
            </h4>
            <p class="text-stone-600 text-sm font-normal leading-relaxed mb-4" data-i18n="kitchenDesc">
              Nevera combi grande con congelador, cafetera para desayunos frente al mar, microondas, vitrocerámica, sartenes y menaje completo.
            </p>
          </div>
          <div class="pt-4 border-t border-stone-100 text-xs text-stone-500 font-medium">
            Nevera grande · Cafetera · Microondas · Menaje
          </div>
        </div>

        <!-- Baño -->
        <div class="bg-white rounded-3xl p-8 border border-stone-200/80 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-stone-50 border border-stone-200/60 text-stone-900 flex items-center justify-center mb-6">
              <Bath class="w-6 h-6 stroke-[1.25]" />
            </div>
            <h4 class="font-serif text-xl sm:text-2xl text-stone-900 font-normal mb-3 tracking-tight" data-i18n="bathTitle">
              Baño con Ducha y Secador
            </h4>
            <p class="text-stone-600 text-sm font-normal leading-relaxed mb-4" data-i18n="bathDesc">
              Plato de ducha con mampara, agua caliente continua, secador de pelo potente, espejo amplio iluminado y toallas limpias de algodón.
            </p>
          </div>
          <div class="pt-4 border-t border-stone-100 text-xs text-stone-500 font-medium">
            Plato de ducha · Secador potente · Toallas
          </div>
        </div>

      </div>
    </div>

    <!-- Minimalist Amenities Bar with Pet Friendly -->
    <div class="bg-white rounded-3xl p-8 sm:p-10 border border-stone-200/80 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
      <h3 class="font-serif text-xl sm:text-2xl text-stone-900 font-normal text-center mb-8 tracking-tight" data-i18n="amenitiesTitle">
        Detalles incluidos para una estancia perfecta
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-6 text-center">
        <div class="flex flex-col items-center">
          <Wifi class="w-5 h-5 text-stone-700 stroke-[1.5] mb-2" />
          <span class="text-xs font-medium text-stone-900" data-i18n="amenityWifi">WiFi Fibra Óptica</span>
          <span class="text-[11px] text-stone-500 font-normal">Alta velocidad</span>
        </div>
        <div class="flex flex-col items-center">
          <Sun class="w-5 h-5 text-stone-700 stroke-[1.5] mb-2" />
          <span class="text-xs font-medium text-stone-900" data-i18n="amenityBeach">Playa La Concha</span>
          <span class="text-[11px] text-stone-500 font-normal">2 min a pie</span>
        </div>
        <div class="flex flex-col items-center">
          <Coffee class="w-5 h-5 text-stone-700 stroke-[1.5] mb-2" />
          <span class="text-xs font-medium text-stone-900" data-i18n="amenityCoffee">Cafetera</span>
          <span class="text-[11px] text-stone-500 font-normal">Para tus mañanas</span>
        </div>
        <div class="flex flex-col items-center">
          <Baby class="w-5 h-5 text-stone-700 stroke-[1.5] mb-2" />
          <span class="text-xs font-medium text-stone-900" data-i18n="amenityBaby">Cuna de Viaje</span>
          <span class="text-[11px] text-stone-500 font-normal">Bajo petición</span>
        </div>
        <div class="flex flex-col items-center">
          <Refrigerator class="w-5 h-5 text-stone-700 stroke-[1.5] mb-2" />
          <span class="text-xs font-medium text-stone-900" data-i18n="amenityFridge">Nevera Grande</span>
          <span class="text-[11px] text-stone-500 font-normal">Con congelador</span>
        </div>
        <div class="flex flex-col items-center">
          <Flame class="w-5 h-5 text-stone-700 stroke-[1.5] mb-2" />
          <span class="text-xs font-medium text-stone-900" data-i18n="amenityHeating">Calefacción</span>
          <span class="text-[11px] text-stone-500 font-normal">Confort térmico</span>
        </div>
        <div class="flex flex-col items-center col-span-2 sm:col-span-1">
          <Heart class="w-5 h-5 text-stone-700 stroke-[1.5] mb-2" />
          <span class="text-xs font-medium text-stone-900" data-i18n="amenityPet">🐾 Pet Friendly</span>
          <span class="text-[11px] text-stone-500 font-normal">Sin suplemento</span>
        </div>
      </div>
    </div>

  </div>
</section>
