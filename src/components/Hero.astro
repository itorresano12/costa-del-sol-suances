---
import { 
  Waves, 
  MapPin, 
  Wifi, 
  BedDouble, 
  ShieldCheck, 
  Sparkles, 
  CheckCircle, 
  ArrowRight,
  Maximize2,
  Users,
  Footprints
} from 'lucide-astro';
---

<section id="inicio" class="relative overflow-hidden pt-8 pb-16 lg:pt-14 lg:pb-24">
  <!-- Background subtle gradient elements -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-teal-50/70 via-white to-slate-50"></div>
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[1000px] h-[400px] bg-gradient-to-tr from-teal-200/40 to-blue-200/40 blur-3xl -z-10 rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Conversion Alert Pill (High Contrast WCAG AA compliant) -->
    <div class="flex justify-center mb-6">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-100 border border-emerald-300 text-emerald-950 text-xs sm:text-sm font-bold shadow-sm cursor-default">
        <Sparkles class="w-4 h-4 text-emerald-700 animate-pulse flex-shrink-0" />
        <span>Reserva directa sin comisiones de Airbnb ni Booking</span>
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
        <span class="text-emerald-900 font-extrabold underline decoration-emerald-500 underline-offset-2">Mejor precio garantizado</span>
      </div>
    </div>

    <!-- Main Hero Headings -->
    <div class="text-center max-w-4xl mx-auto">
      <div class="inline-flex items-center justify-center gap-2 text-teal-950 font-bold text-xs sm:text-sm mb-3 px-3.5 py-1 rounded-full bg-teal-100/80 border border-teal-200">
        <MapPin class="w-4 h-4 text-teal-800 flex-shrink-0" />
        <span>Suances, Cantabria — Frente a la Playa de La Concha (2 min a pie)</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-950 tracking-tight leading-[1.12]">
        Apartamento <span class="bg-gradient-to-r from-teal-700 via-teal-600 to-emerald-600 bg-clip-text text-transparent">Costa del Sol</span> Suances
      </h1>

      <p class="mt-5 text-base sm:text-lg lg:text-xl text-slate-700 leading-relaxed max-w-3xl mx-auto font-normal">
        Disfruta de tus vacaciones junto al Mar Cantábrico en un piso amplio de <strong class="text-slate-900 font-bold">70 m²</strong> con <strong class="text-slate-900 font-bold">3 dormitorios</strong>, salón con vistas, cocina equipada con cafetera y nevera, baño completo y <strong class="text-slate-900 font-bold">WiFi gratis</strong>.
      </p>

      <!-- Trust Badges List -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-2.5 sm:gap-3 text-xs sm:text-sm font-semibold text-slate-800">
        <div class="flex items-center gap-1.5 bg-white px-3.5 py-2 rounded-xl border border-slate-300 shadow-sm">
          <CheckCircle class="w-4 h-4 text-emerald-600 flex-shrink-0" />
          <span>Frente a la playa (a 2 min)</span>
        </div>
        <div class="flex items-center gap-1.5 bg-white px-3.5 py-2 rounded-xl border border-slate-300 shadow-sm">
          <Waves class="w-4 h-4 text-teal-600 flex-shrink-0" />
          <span>Vistas panorámicas al mar</span>
        </div>
        <div class="flex items-center gap-1.5 bg-white px-3.5 py-2 rounded-xl border border-slate-300 shadow-sm">
          <Wifi class="w-4 h-4 text-blue-600 flex-shrink-0" />
          <span>WiFi rápido gratis</span>
        </div>
        <div class="flex items-center gap-1.5 bg-white px-3.5 py-2 rounded-xl border border-slate-300 shadow-sm">
          <ShieldCheck class="w-4 h-4 text-emerald-700 flex-shrink-0" />
          <span>Sin costes de intermediarios (-15%)</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
        <a 
          href="#reservas"
          class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-teal-600 via-teal-700 to-emerald-600 hover:from-teal-700 hover:to-emerald-700 text-white font-extrabold text-base shadow-xl shadow-teal-700/25 hover:shadow-teal-700/35 hover:-translate-y-0.5 active:scale-95 transition-all flex items-center justify-center gap-2 group"
        >
          <span>Calcular Precio y Reservar Directo</span>
          <ArrowRight class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
        </a>

        <a 
          href="#galeria"
          class="w-full sm:w-auto px-7 py-4 rounded-2xl bg-white hover:bg-slate-50 text-slate-900 font-bold text-base border-2 border-slate-200 shadow-sm hover:border-slate-300 transition flex items-center justify-center gap-2"
        >
          <span>Ver Fotos del Piso</span>
        </a>
      </div>

    </div>

    <!-- Hero Image Showcase with High-Contrast Specs Banner -->
    <div class="mt-12 relative max-w-6xl mx-auto">
      <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white bg-slate-950 group">
        <img 
          src="/images/apartamento/hero-vistas.jpg" 
          alt="Vistas al mar y playa de La Concha desde el Apartamento Costa del Sol Suances" 
          class="w-full h-[380px] sm:h-[480px] lg:h-[560px] object-cover group-hover:scale-105 transition-transform duration-700 brightness-95"
          loading="eager"
        />

        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/20 to-transparent"></div>

        <!-- Overlaid High-Contrast Specs Banner (Desktop & Mobile) -->
        <div class="absolute bottom-4 sm:bottom-6 left-4 sm:left-6 right-4 sm:right-6 bg-slate-950/90 backdrop-blur-xl rounded-2xl sm:rounded-3xl p-4 sm:p-6 border border-white/20 shadow-2xl text-white">
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-6 divide-y sm:divide-y-0 sm:divide-x divide-white/10">
              <div class="pt-2 sm:pt-0 sm:px-2 flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-teal-500/20 border border-teal-400/30 flex items-center justify-center text-teal-300 flex-shrink-0">
                  <Maximize2 class="w-5 h-5" />
                </div>
                <div>
                  <span class="block text-[11px] uppercase tracking-wider text-slate-300 font-bold">Espacio</span>
                  <span class="text-lg sm:text-xl font-extrabold text-white">70 m²</span>
                </div>
              </div>

              <div class="pt-2 sm:pt-0 sm:pl-6 flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-teal-500/20 border border-teal-400/30 flex items-center justify-center text-teal-300 flex-shrink-0">
                  <BedDouble class="w-5 h-5" />
                </div>
                <div>
                  <span class="block text-[11px] uppercase tracking-wider text-slate-300 font-bold">Dormitorios</span>
                  <span class="text-lg sm:text-xl font-extrabold text-white">3 Habitaciones</span>
                </div>
              </div>

              <div class="pt-2 sm:pt-0 sm:pl-6 flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-teal-500/20 border border-teal-400/30 flex items-center justify-center text-teal-300 flex-shrink-0">
                  <Users class="w-5 h-5" />
                </div>
                <div>
                  <span class="block text-[11px] uppercase tracking-wider text-slate-300 font-bold">Capacidad</span>
                  <span class="text-lg sm:text-xl font-extrabold text-white">Hasta 6 personas</span>
                </div>
              </div>

              <div class="pt-2 sm:pt-0 sm:pl-6 flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-300 flex-shrink-0">
                  <Footprints class="w-5 h-5" />
                </div>
                <div>
                  <span class="block text-[11px] uppercase tracking-wider text-emerald-300 font-bold">Playa La Concha</span>
                  <span class="text-lg sm:text-xl font-extrabold text-emerald-400">2 min a pie</span>
                </div>
              </div>
            </div>

            <div class="hidden sm:flex items-center justify-end">
              <a 
                href="#reservas"
                class="px-6 py-3 rounded-xl bg-gradient-to-r from-teal-500 to-emerald-500 hover:from-teal-600 hover:to-emerald-600 text-slate-950 font-extrabold text-sm shadow-lg shadow-teal-500/30 hover:scale-105 transition whitespace-nowrap"
              >
                Comprobar Fechas
              </a>
            </div>

          </div>
        </div>

      </div>
    </div>

  </div>
</section>
